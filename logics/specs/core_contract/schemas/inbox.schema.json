{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crow/core/inbox.schema.json",
  "title": "inbox row",
  "description": "One item the owner answers: a version file at a gate or a parked question.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mission", "kind", "project", "type", "source", "version", "file", "ask", "verbs", "blocking",
               "artifacts", "state", "created", "answered"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{8}-[a-z-]+-[a-z0-9_!#@.-]+/v[0-9]+(/q[0-9]+)?$"},
    "mission": {"type": "string"},
    "kind": {"type": "string"},
    "project": {"type": "string"},
    "type": {"enum": ["choice", "approval", "review", "fyi", "needs-input"]},
    "source": {"enum": ["plan", "report", "mockup", "questions"]},
    "version": {"type": "integer", "minimum": 1},
    "file": {"type": "string", "pattern": "^((plan|report|mockup)\\.v[0-9]+\\.md|outbox/questions\\.json)$"},
    "ask": {"type": "string", "minLength": 1, "maxLength": 200, "description": "One line: block summary or question text."},
    "verbs": {"type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"enum": ["go", "dig", "no", "ok", "msg", "abandon", "pick", "change", "approve", "answer"]}},
    "blocking": {"type": "boolean", "description": "An open blocking question refuses go, ok and approve."},
    "artifacts": {"type": "array", "items": {"type": "string", "pattern": "^outbox/"}},
    "state": {"enum": ["open", "answered", "dropped"]},
    "created": {"type": "string", "format": "date-time"},
    "answered": {"type": ["string", "null"], "format": "date-time"},
    "compare": {
      "type": "object", "additionalProperties": false,
      "description": "The first decision of a crow-compare spec among the artifacts: options and scenarios of a design review.",
      "required": ["question", "recommend", "rows", "options"],
      "properties": {
        "question": {"type": "string"},
        "recommend": {"type": "string", "description": "Label of the recommended option, or empty."},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Scenario labels, one per image row."},
        "options": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "note", "images"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "note": {"type": "string"},
            "images": {"type": "array", "description": "One image per row, null when the option has none.",
                       "items": {"type": ["string", "null"], "pattern": "^outbox/"}}
          }}}
      }
    }
  }
}

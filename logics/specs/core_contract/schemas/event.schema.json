{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crow/core/event.schema.json",
  "title": "event line",
  "description": "One line of missions/<id>/events.jsonl, the source of truth the store is rebuilt from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "mission", "type", "actor", "data"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "mission": {"type": "string", "pattern": "^[0-9]{8}-[a-z-]+-[a-z0-9_!#@.-]+$"},
    "type": {"enum": ["created", "state", "run_start", "run_end", "gate", "question", "answer", "validation",
                      "validation_dropped", "publish", "incident", "action"]},
    "actor": {"enum": ["owner", "core", "run"]},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "created"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/created"}}}},
    {"if": {"properties": {"type": {"const": "state"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/state"}}}},
    {"if": {"properties": {"type": {"const": "run_start"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/run_start"}}}},
    {"if": {"properties": {"type": {"const": "run_end"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/run_end"}}}},
    {"if": {"properties": {"type": {"const": "gate"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/gate"}}}},
    {"if": {"properties": {"type": {"const": "question"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/question"}}}},
    {"if": {"properties": {"type": {"const": "answer"}}, "required": ["type"]},
     "then": {"properties": {"actor": {"const": "owner"}, "data": {"$ref": "#/$defs/answer"}}}},
    {"if": {"properties": {"type": {"const": "validation"}}, "required": ["type"]},
     "then": {"properties": {"actor": {"const": "owner"}, "data": {"$ref": "../../req_037_run_contract/schemas/validation-event.schema.json#/properties/data"}}}},
    {"if": {"properties": {"type": {"const": "validation_dropped"}}, "required": ["type"]},
     "then": {"properties": {"actor": {"const": "owner"}, "data": {"$ref": "../../req_037_run_contract/schemas/validation-event.schema.json#/properties/data"}}}},
    {"if": {"properties": {"type": {"const": "publish"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/publish"}}}},
    {"if": {"properties": {"type": {"const": "incident"}}, "required": ["type"]},
     "then": {"properties": {"data": {"$ref": "#/$defs/incident"}}}},
    {"if": {"properties": {"type": {"const": "action"}}, "required": ["type"]},
     "then": {"properties": {"actor": {"const": "owner"}, "data": {"$ref": "#/$defs/action"}}}}
  ],
  "$defs": {
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "surface"],
      "properties": {
        "kind": {"type": "string"},
        "key": {"type": "string"},
        "surface": {"$ref": "#/$defs/surface"},
        "project": {"type": "string"},
        "scope": {"enum": ["work", "personal", "crow"]},
        "data_class": {"enum": ["work", "personal", "private"]},
        "goal": {"type": "string"},
        "end_state": {"type": "string"},
        "autonomy": {"enum": ["ask", "notify", "auto"]},
        "gates": {"$ref": "mission.schema.json#/$defs/gates"},
        "budget": {"$ref": "mission.schema.json#/properties/budget"},
        "file_scope": {"type": "array", "items": {"type": "string"}},
        "batch": {"type": "string"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "mission.schema.json#/$defs/state"},
        "to": {"$ref": "mission.schema.json#/$defs/state"},
        "reason": {"type": "string"}
      }
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "account_class", "cold", "version"],
      "properties": {
        "run": {"type": "string", "pattern": "^[0-9a-f]{8,40}$"},
        "account": {"type": "string"},
        "account_class": {"enum": ["work", "personal", "crow"]},
        "cold": {"type": "boolean"},
        "version": {"type": "integer", "minimum": 1},
        "resume_of": {"type": "string", "pattern": "^[0-9a-f]{8,40}$", "description": "Run id this run resumes (item_135)."}
      }
    },
    "run_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "cause"],
      "properties": {
        "run": {"type": "string", "pattern": "^[0-9a-f]{8,40}$"},
        "cause": {"enum": ["done", "usage_limit", "budget", "timeout", "error", "stopped"]},
        "exit": {"type": "integer"},
        "file": {"type": "string", "description": "Version file the run left, if any."}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "verdict"],
      "properties": {
        "file": {"type": "string", "pattern": "^(plan|report|mockup)\\.v[0-9]+\\.md$"},
        "verdict": {"enum": ["ready", "blocked", "needs-input"]}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "version", "ids"],
      "properties": {
        "file": {"const": "outbox/questions.json"},
        "version": {"type": "integer", "minimum": 1},
        "ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^q[0-9]+$"}}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "verb"],
      "properties": {
        "file": {"type": "string", "pattern": "^answers\\.v[0-9]+\\.md$"},
        "verb": {"enum": ["go", "dig", "no", "ok", "msg", "abandon", "pick", "change", "approve", "answer"]},
        "surface": {"$ref": "#/$defs/surface"},
        "item": {"type": "string", "description": "Inbox row id."}
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "result", "validation_ts"],
      "properties": {
        "action": {"enum": ["commit-docs", "push", "merge", "mr", "post-comments", "reply-resolve", "page", "mail-draft", "vault-note", "next-mission"]},
        "result": {"enum": ["ok", "failed"]},
        "validation_ts": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "surface"],
      "description": "An owner action without a file of its own (item_147).",
      "properties": {
        "action": {"enum": ["stop", "cancel", "hide"]},
        "surface": {"$ref": "#/$defs/surface"},
        "item": {"type": "string", "description": "Inbox row id, for hide."},
        "run": {"type": "string", "description": "cdx run id, for stop."},
        "reason": {"type": "string"}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause"],
      "properties": {
        "cause": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
        "detail": {"type": "string"}
      }
    },
    "surface": {"enum": ["nest", "deck", "cli", "schedule"]}
  }
}

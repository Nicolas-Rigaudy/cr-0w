#!/usr/bin/env bash
# crow: launcher for the CR-0W hub, built on cdx.
#
# Start
#   crow                 open the hub session
#   crow open [--model M] [--on-busy fail] <project> [prompt | --task T --end-state E]
#                        open a session in a registered project, optionally on a first message (model: opus, sonnet)
#   crow term [--model M] [--on-busy fail] <project> [...]   same, in a new terminal window (safe to call from inside a Claude session)
#   crow handoff <project> --task T --end-state E [--context C]   hand the work to a repo session (crow term)
#   open, term and handoff pick a free allowed account with quota left (crow-accounts pick);
#   CROW_ACCOUNT=<name> forces one. --on-busy fail never asks (scripts).
#   term, focus and relaunch open windows through CROW_TERMINAL=kitty|tmux|print (unset: kitty, else tmux, else print).
#   crow work <project>  index of a repo's own tools (skills, CLAUDE.md, hooks) for hub work on it
# See
#   crow deck [--theme t] control room: 5 tabs, 4 themes (? for keys)
#   crow watch           older live board: 1 agents · 2 usage (? for keys)
#   crow runs [--all]    background runs: status, task, commits so far
#   crow runs sessions [...]   sessions cut off by a usage limit (see crow-sessions)
#   crow ls              list registered projects
#   crow json            agents as JSON (for widgets)
#   crow report <run_id> print a run's final report
# Delegate
#   crow dispatch <project> <label> --prompt-file F [--model opus]   start a tracked background run
#   crow runs relaunch <id> <account> [--dry-run] [--here]   continue a cut-off session on another allowed account; relaunch status
#   crow rescue <account> [--to T] [--dry-run]   move every session the account lost in its last 5h window, one OK
#   crow focus --pid P --account A --cwd D   focus a session's window, or resume it
# Rituals
#   crow brief           print the morning brief (one-shot run)
#   crow daily           draft today's daily into the state dir (one-shot run; post it from the hub)
#   crow weekly          build the weekly rollup + slide outline (one-shot run)
# Data
#   crow usage [--json]  token usage, cost and limits across cdx accounts (see crow-usage)
#   crow activity [...]  raw activity (see crow-activity --help)
#   crow note "text #tag"  one-line timestamped capture into today's daily note (no model)
#   crow notes [--since 7d]  vault notes of the last days as compact JSON (recap input)
#   crow projects [...]  release tracks: roadmap progress toward public releases
#   crow release propose  draft the next version and notes from commits since the last tag (no tagging)
#   crow doctor [--json] identity, accounts, stale worktrees (read only)
#   crow secret set|get|list|rm <service> [--user U]   service tokens in the keyring (see runbooks/service-tokens.md)
#
# Old names still work and print a hint: sessions, relaunch (now under runs), releases (now projects).
set -euo pipefail

CROW_HOME="${CROW_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
# launch() gives a session its account as CROW_SESSION_ACCOUNT, so a CROW_ACCOUNT seen here is a choice.
# Sessions started before that inherit CROW_ACCOUNT: there it is dropped when it names the session's own
# account, unless crow itself passed it down (CROW_ACCOUNT_PICKED).
CROW_ACCOUNT_GIVEN="${CROW_ACCOUNT:-}"
[[ -z "${CROW_SESSION_ACCOUNT:-}" && -z "${CROW_ACCOUNT_PICKED:-}" && -n "${CDX_SESSION_NAME:-}" \
   && "$CROW_ACCOUNT_GIVEN" == "$CDX_SESSION_NAME" ]] && CROW_ACCOUNT_GIVEN=""
CROW_ACCOUNT="${CROW_ACCOUNT:-$("$CROW_HOME/bin/crow-accounts" default)}"
REGISTRY="$CROW_HOME/local/projects.yaml"
export CROW_HOME

# project_path <name|alias>: the folder sessions open in; a `planning:` project opens in its planning repo.
project_path() {
  python3 - "$REGISTRY" "$1" <<'EOF'
import sys, yaml
reg = yaml.safe_load(open(sys.argv[1]))["projects"]
find = lambda n: next((p for p in reg if p["name"] == n or n in p.get("aliases", [])), None)
p = find(sys.argv[2]) or sys.exit(f"crow: unknown project '{sys.argv[2]}' (see: crow ls)")
if p.get("planning"):
    home = find(p["planning"]) or sys.exit(f"crow: {p['name']}: unknown planning project '{p['planning']}'")
    print(f"crow: {p['name']} is worked from {home['name']} (registry planning:)", file=sys.stderr)
    p = home
print(p["path"])
EOF
}

# Start an interactive cdx session. On a shared account the memory is linked from local/memory
# for the session only (no copy stays in the profile), then unlinked and committed.
# The session sees its account as CROW_SESSION_ACCOUNT, never as CROW_ACCOUNT.
launch() {
  local dir="$1"; shift
  local run=(env -u CROW_ACCOUNT -u CROW_ACCOUNT_PICKED CROW_SESSION_ACCOUNT="$CROW_ACCOUNT" cdx)
  "$CROW_HOME/bin/crow-accounts" require "$CROW_ACCOUNT"
  [[ "$dir" == "$CROW_HOME" ]] && "$CROW_HOME/bin/crow-accounts" hub-session "$CROW_ACCOUNT"
  if [[ "$("$CROW_HOME/bin/crow-accounts" memory "$CROW_ACCOUNT")" == session ]]; then
    "$CROW_HOME/bin/crow-memory" link "$CROW_ACCOUNT"
    trap '"$CROW_HOME/bin/crow-memory" unlink "$CROW_ACCOUNT"; "$CROW_HOME/bin/crow-memory" commit' EXIT
    "${run[@]}" "$CROW_ACCOUNT" --dir "$dir" "$@"
  else
    exec "${run[@]}" "$CROW_ACCOUNT" --dir "$dir" "$@"
  fi
}

# pick_account: a free allowed account with quota left, unless CROW_ACCOUNT names one.
pick_account() {
  [[ -n "$CROW_ACCOUNT_GIVEN" ]] && return 0
  CROW_ACCOUNT="$("$CROW_HOME/bin/crow-accounts" pick --on-busy "$on_busy")" || exit 1
  CROW_ACCOUNT_GIVEN="$CROW_ACCOUNT"
}

# launch_opts: leading --model M / --on-busy B of open and term.
on_busy=ask
model=()
launch_opts() {
  n=0
  while :; do
    case "${1:-}" in
      --model)   model=(--model "${2:?usage: crow open|term [--model M] [--on-busy fail] <project> ...}"); shift 2; n=$((n+2)) ;;
      --on-busy) on_busy="${2:?usage: --on-busy ask|fail}"; [[ "$on_busy" == ask || "$on_busy" == fail ]] \
                   || { echo "crow: --on-busy must be ask or fail" >&2; exit 1; }; shift 2; n=$((n+2)) ;;
      *) break ;;
    esac
  done
}

# oneshot <skill> [args]: run a hub skill on the account's provider.
oneshot() {
  local prompt out
  "$CROW_HOME/bin/crow-accounts" require "$CROW_ACCOUNT"
  prompt=$("$CROW_HOME/bin/crow-accounts" prompt "$CROW_ACCOUNT" "$@")
  # Headless flags and env (crow_lib.run_flags): one line of KEY=VALUE pairs, then one argument per line.
  local spec env=() flags=() line
  spec=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import crow_lib as c
f, e = c.run_flags("oneshot", c.provider_of(sys.argv[2]))
print(" ".join(f"{k}={v}" for k, v in e.items())); print("\n".join(f))' "$CROW_HOME/bin" "$CROW_ACCOUNT")
  read -r -a env <<<"$(head -1 <<<"$spec")"
  while IFS= read -r line; do [[ -n "$line" ]] && flags+=("$line"); done < <(tail -n +2 <<<"$spec")
  out=$(env "${env[@]}" cdx run "$CROW_ACCOUNT" --cwd "$CROW_HOME" --prompt "$prompt" "${flags[@]}" \
        --permission "$("$CROW_HOME/bin/crow-accounts" permission "$CROW_ACCOUNT")" --json)
  local ok stdout_path
  ok=$(jq -r '.ok' <<<"$out")
  stdout_path=$(jq -r '.stdout_path' <<<"$out")
  if [[ "$ok" != "true" ]]; then
    jq -r '.error // "run failed"' <<<"$out" >&2
    exit 1
  fi
  # cdx stores the provider's raw output; print only the final Markdown message.
  local text
  text=$("$CROW_HOME/bin/crow-runs" final "$stdout_path" "$(jq -r '.provider // "claude"' <<<"$out")")
  if [[ -t 1 ]] && command -v bat >/dev/null; then
    bat --language md --style plain --paging never <<<"$text"
  else
    printf '%s\n' "$text"
  fi
  jq -r '"\n— \(.usage.total_tokens) tokens · \(.duration_seconds|floor)s · run \(.run_id)"' <<<"$out" >&2
}

# hint <old> <new>: one line on stderr when an old command name is used (stdout stays clean).
hint() { echo "crow: '$1' is now '$2' (the old name still works)" >&2; }

cmd="${1:-hub}"
shift || true
case "$cmd" in
  hub)      launch "$CROW_HOME" ;;
  brief)    oneshot brief ;;
  daily)    oneshot daily "Draft only: write the draft where the skill says and print it. Do not post anything." ;;
  weekly)   oneshot weekly ;;
  open)     launch_opts "$@"; shift "$n"
            [[ ${#model[@]} -gt 0 ]] && export ANTHROPIC_MODEL="${model[1]}"
            dir="$(project_path "${1:?usage: crow open [--model M] <project> [prompt | --task T --end-state E]}")"
            pick_account
            if [[ "${2:-}" == --task ]]; then launch "$dir" --on-busy "$on_busy" "${@:2}"
            else launch "$dir" --on-busy "$on_busy" ${2:+--prompt "$2"}; fi ;;
  term)     # A new terminal window (crow_term backend: kitty, tmux, or print the command), detached
            # from the calling session: real HOME and no inherited Claude/cdx variables.
            # The account is picked here, where the caller sees a refusal, and passed down.
            launch_opts "$@"; shift "$n"
            dir="$(project_path "${1:?usage: crow term [--model M] <project> [prompt | --task T --end-state E]}")"
            pick_account
            line=$(python3 "$CROW_HOME/bin/crow_term.py" open --title "crow · $1 · $CROW_ACCOUNT" --set CROW_ACCOUNT="$CROW_ACCOUNT" \
                   -- "$CROW_HOME/bin/crow" open ${model[@]+"${model[@]}"} --on-busy "$on_busy" "$@")
            if [[ -n "$line" ]]; then
              echo "crow: no terminal backend (CROW_TERMINAL=kitty|tmux); run this in a new terminal:" >&2
              printf '%s\n' "$line"
            else
              echo "crow: $1 opened on $CROW_ACCOUNT" >&2
            fi ;;
  work)     exec "$CROW_HOME/bin/crow-project" work "$@" ;;
  handoff)  # Pick before writing the note: a refusal leaves no orphan note.
            pick_account
            task="$("$CROW_HOME/bin/crow-project" handoff --for-cdx "$@")"
            end=""; prev=""; for a in "$@"; do [[ "$prev" == --end-state ]] && end="$a"; [[ "$a" == --end-state=* ]] && end="${a#--end-state=}"; prev="$a"; done
            CROW_ACCOUNT="$CROW_ACCOUNT" CROW_ACCOUNT_PICKED=1 exec "$CROW_HOME/bin/crow" term "$1" --task "$task" --end-state "$end" ;;
  ls)       python3 -c "
import yaml
for p in yaml.safe_load(open('$REGISTRY'))['projects']:
    print(f\"{p['name']:<30} {p['scope']:<9} {p['status']:<9} {p['path']}\")" ;;
  runs)     case "${1:-}" in
              sessions) shift; exec "$CROW_HOME/bin/crow-sessions" "$@" ;;
              relaunch) shift; exec "$CROW_HOME/bin/crow-relaunch" "$@" ;;
              *)        exec "$CROW_HOME/bin/crow-runs" list "$@" ;;
            esac ;;
  rescue)   exec "$CROW_HOME/bin/crow-relaunch" rescue "$@" ;;
  dispatch) exec "$CROW_HOME/bin/crow-runs" dispatch "$@" ;;
  json)     exec "$CROW_HOME/bin/crow-runs" json "$@" ;;
  report)   exec "$CROW_HOME/bin/crow-runs" report "$@" ;;
  watch)    # rebuild the Go board when its source is newer than the binary
            src="$CROW_HOME/tools/crow-watch"; bin="$src/crow-watch"
            if [[ ! -x "$bin" || -n "$(find "$src" -name '*.go' -newer "$bin" -o -name go.mod -newer "$bin")" ]]; then
              (cd "$src" && go build -o crow-watch .) || exit 1
            fi
            exec "$bin" "$@" ;;
  deck)     # the control room (skeleton): rebuild when its source is newer than the binary
            src="$CROW_HOME/tools/crow-deck"; bin="$src/crow-deck"
            if [[ ! -x "$bin" || -n "$(find "$src" -name '*.go' -newer "$bin" -o -name go.mod -newer "$bin")" ]]; then
              (cd "$src" && go build -o crow-deck .) || exit 1
            fi
            exec "$bin" "$@" ;;
  focus)    exec "$CROW_HOME/bin/crow-focus" "$@" ;;
  sessions) hint "crow sessions" "crow runs sessions"; exec "$CROW_HOME/bin/crow-sessions" "$@" ;;
  relaunch) hint "crow relaunch" "crow runs relaunch"; exec "$CROW_HOME/bin/crow-relaunch" "$@" ;;
  usage)    exec "$CROW_HOME/bin/crow-usage" "$@" ;;
  activity) exec "$CROW_HOME/bin/crow-activity" "$@" ;;
note) exec "$CROW_HOME/bin/crow-note" "$@" ;;
notes) exec "$CROW_HOME/bin/crow-notes" "$@" ;;
  projects) exec "$CROW_HOME/bin/crow-releases" "$@" ;;
  releases) hint "crow releases" "crow projects"; exec "$CROW_HOME/bin/crow-releases" "$@" ;;
  release)  case "${1:-}" in
              propose) shift; exec "$CROW_HOME/bin/crow-release-propose" "$@" ;;
              *) echo "usage: crow release propose [--json]" >&2; exit 1 ;;
            esac ;;
  doctor)   exec "$CROW_HOME/bin/crow-doctor" "$@" ;;
  secret)   exec "$CROW_HOME/bin/crow-secret" "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *)        echo "crow: unknown command '$cmd' (crow help)" >&2; exit 1 ;;
esac

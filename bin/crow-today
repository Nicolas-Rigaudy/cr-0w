#!/usr/bin/env python3
"""crow-today: today's calendar and mail counts from Microsoft Graph, for the deck Today box.

  crow-today login     device-code sign-in once; stores the refresh token in the keyring
  crow-today json      today's data as JSON (cached for 5 minutes in local/state/today.json)
  crow-today json -f   skip the cache
  crow-today done ID   mark the mail's flag complete
  crow-today snooze ID flag the mail due tomorrow 08:00; Today hides it until then
  crow-today thread ID print the mail's thread, newest first (sender, date, plain body)
  crow-today draft ID [--all] < text   save a reply draft above the quote in Outlook Drafts (never sends)

Config: local/graph.yaml (tenant, client_id, user, timezone, mark_important).
With mark_important: true, crow flags the mail it picks (category "crow"), once per mail, and
clears its own flag when you answered; Today then lists every flagged mail. Keyring: service crow-graph, user <user>.
JSON: {"at", "events": [{"start","end","subject","all_day","next"}], "tomorrow": [...],
       "unread", "flagged": [{"id","subject","from","crow","webLink","until"}], "drafts",
       "important": [{"id","subject","from","at","unread","high","webLink"}]}. until: ISO time a snoozed flag returns.. Exit 2 when not signed in.
"""
import datetime as dt, json, os, sys, time, urllib.error, urllib.parse, urllib.request
import re
import yaml

from crow_lib import secret_lookup, secret_store

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402
HOME = crow_lib.data_home()
CONF = os.path.join(HOME, "local", "graph.yaml")
CACHE = os.path.join(HOME, "local", "state", "today.json")
SCOPE = "https://graph.microsoft.com/.default offline_access"  # the scopes the admin consented
GRAPH = "https://graph.microsoft.com/v1.0"
TTL = 300


def conf():
    with open(CONF) as f:
        return yaml.safe_load(f)


def post(url, data):
    req = urllib.request.Request(url, urllib.parse.urlencode(data).encode())
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        return json.load(e)


def keyring(c, token=None):
    if token:
        return secret_store("crow-graph", c["user"], token, "crow Graph refresh token")
    return secret_lookup("crow-graph", c["user"]).strip()


def authority(c):
    return f"https://login.microsoftonline.com/{c['tenant']}/oauth2/v2.0"


def login(c):
    d = post(authority(c) + "/devicecode", {"client_id": c["client_id"], "scope": SCOPE})
    if "device_code" not in d:
        sys.exit("devicecode failed: " + d.get("error_description", str(d)))
    print(d["message"], flush=True)
    end = time.time() + d.get("expires_in", 900)
    while time.time() < end:
        time.sleep(d.get("interval", 5))
        t = post(authority(c) + "/token", {"grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                                            "client_id": c["client_id"], "device_code": d["device_code"]})
        if "refresh_token" in t:
            keyring(c, t["refresh_token"])
            print("signed in; refresh token stored in the keyring")
            return
        if t.get("error") not in ("authorization_pending", "slow_down"):
            sys.exit("login failed: " + t.get("error_description", str(t)))
    sys.exit("login timed out")


def access(c):
    rt = keyring(c)
    if not rt:
        print("not signed in: run crow-today login", file=sys.stderr)
        sys.exit(2)
    t = post(authority(c) + "/token", {"grant_type": "refresh_token", "client_id": c["client_id"],
                                        "refresh_token": rt, "scope": SCOPE})
    if "access_token" not in t:
        print("token refresh failed: " + t.get("error_description", str(t)).splitlines()[0], file=sys.stderr)
        sys.exit(2)
    if t.get("refresh_token") and t["refresh_token"] != rt:
        keyring(c, t["refresh_token"])
    return t["access_token"]


TZ = "UTC"


def get(tok, path, extra=None):
    h = {"Authorization": "Bearer " + tok, "Prefer": f'outlook.timezone="{TZ}"'}
    h.update(extra or {})
    with urllib.request.urlopen(urllib.request.Request(GRAPH + path, headers=h), timeout=20) as r:
        return json.load(r)


def events(tok, day):
    q = urllib.parse.urlencode({"startDateTime": day.isoformat(), "endDateTime": (day + dt.timedelta(days=1)).isoformat(),
                                "$select": "subject,start,end,isAllDay,isCancelled,showAs", "$orderby": "start/dateTime", "$top": "30"})
    out, seen = [], set()
    for e in get(tok, "/me/calendarView?" + q)["value"]:
        if e.get("isCancelled") or e.get("showAs") == "free" and not e.get("isAllDay"):
            continue
        lo, hi = day.strftime("%Y-%m-%dT%H:%M"), (day + dt.timedelta(days=1)).strftime("%Y-%m-%dT%H:%M")
        if e["end"]["dateTime"][:16] <= lo or e["start"]["dateTime"][:16] >= hi:
            continue  # Graph returns events that only touch the window edge
        key = (e["start"]["dateTime"][:16], e.get("subject"))
        if key in seen:
            continue
        seen.add(key)
        out.append({"start": e["start"]["dateTime"][:16], "end": e["end"]["dateTime"][:16],
                    "subject": e.get("subject") or "(no subject)", "all_day": bool(e.get("isAllDay"))})
    return out


BOT = re.compile(r"no-?reply|notification|mailer|bounce|newsletter|marketing|^info@|^news|^contact@|^support@|^salle_|alert", re.I)
RSVP = re.compile(r"^(accepted|accepté|declined|refusé|tentative|provisoire)\s*:", re.I)


def important(tok, me, days=3, limit=5):
    """Mail worth a look: from a colleague or someone you wrote to in 90 days, sent to you
    directly, in the last few days, not a meeting reply, and not answered yet."""
    me = me.lower()
    domain = me.split("@")[-1]
    now = dt.datetime.now(dt.timezone.utc)
    iso = lambda d: d.strftime("%Y-%m-%dT%H:%M:%SZ")
    sq = urllib.parse.urlencode({"$filter": f"sentDateTime ge {iso(now - dt.timedelta(days=90))}",
                                 "$select": "toRecipients,ccRecipients,conversationId,sentDateTime", "$top": "300"})
    known, answered = set(), {}
    for m in get(tok, "/me/mailFolders/sentitems/messages?" + sq)["value"]:
        for r in m.get("toRecipients", []) + m.get("ccRecipients", []):
            known.add(r["emailAddress"]["address"].lower())
        cid = m.get("conversationId")
        answered[cid] = max(answered.get(cid, ""), m.get("sentDateTime", ""))
    iq = urllib.parse.urlencode({"$filter": f"receivedDateTime ge {iso(now - dt.timedelta(days=days))}",
                                 "$select": "id,subject,from,toRecipients,isRead,importance,receivedDateTime,conversationId,categories,flag,webLink",
                                 "$orderby": "receivedDateTime desc", "$top": "100"})
    out, seen = [], set()
    for m in get(tok, "/me/mailFolders/inbox/messages?" + iq)["value"]:
        a = (m.get("from") or {}).get("emailAddress") or {}
        addr = a.get("address", "").lower()
        to = [r["emailAddress"]["address"].lower() for r in m.get("toRecipients", [])]
        cid = m.get("conversationId")
        if (m.get("@odata.type", "").endswith("eventMessage") or RSVP.match(m.get("subject") or "")
                or BOT.search(addr) or addr == me or me not in to or cid in seen
                or not (addr.endswith("@" + domain) or addr in known)
                or answered.get(cid, "") > m["receivedDateTime"]
                or (m.get("flag") or {}).get("flagStatus") == "complete" or snoozed(m, now)):
            continue
        seen.add(cid)
        out.append({"id": m["id"], "subject": m.get("subject") or "", "from": a.get("name") or addr,
                    "at": m["receivedDateTime"], "unread": not m.get("isRead"), "high": m.get("importance") == "high",
                    "categories": m.get("categories") or [], "webLink": m.get("webLink", "")})
    out.sort(key=lambda m: (not m["high"], not m["unread"]))
    return out[:limit], answered


MARKED = os.path.join(HOME, "local", "state", "today-marked.json")
CATEGORY = "crow"


def patch(tok, mid, body):
    req = urllib.request.Request(GRAPH + "/me/messages/" + mid, json.dumps(body).encode(), method="PATCH",
                                 headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=20).close()


def mark(tok, picked, answered):
    """Flag each picked mail once, with the crow category. A flag the owner clears stays
    cleared. Crow clears its own flag once the owner answered the thread."""
    try:
        done = json.load(open(MARKED))
    except (OSError, ValueError):
        done = {}
    for m in picked:
        if m["id"] in done:
            m.pop("categories", None)
        else:
            patch(tok, m["id"], {"flag": {"flagStatus": "flagged"},
                                 "categories": sorted(set(m.pop("categories", [])) | {CATEGORY})})
            done[m["id"]] = m["at"]
    old = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=30)).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(MARKED, "w") as f:
        json.dump({k: v for k, v in done.items() if v >= old}, f)  # the picker only looks back 3 days
    fq = urllib.parse.urlencode({"$filter": "flag/flagStatus eq 'flagged'",
                                 "$select": "id,subject,from,categories,conversationId,receivedDateTime,flag,webLink", "$top": "25"})
    out = []
    for m in get(tok, "/me/messages?" + fq)["value"]:
        crow = CATEGORY in (m.get("categories") or [])
        if crow and answered.get(m.get("conversationId"), "") > m["receivedDateTime"]:
            patch(tok, m["id"], {"flag": {"flagStatus": "complete"}})
            continue
        out.append({"id": m["id"], "subject": m.get("subject") or "", "crow": crow, "webLink": m.get("webLink", ""),
                    "until": until(m), "from": ((m.get("from") or {}).get("emailAddress") or {}).get("name", "")})
    return out


def until(m):
    """When a snoozed flag returns, as an aware ISO time; "" when the flag has no start."""
    st = (m.get("flag") or {}).get("startDateTime") or {}
    if not st.get("dateTime"):
        return ""
    t = dt.datetime.fromisoformat(st["dateTime"][:19])
    if st.get("timeZone", "UTC") == "UTC":
        return t.replace(tzinfo=dt.timezone.utc).isoformat()
    return t.astimezone().isoformat()  # another zone: Graph echoes the one we wrote, the machine's


def snoozed(m, now):
    u = until(m)
    return bool(u) and dt.datetime.fromisoformat(u) > now


def drop_cache():
    try:
        os.remove(CACHE)
    except OSError:
        pass


def snooze_at(now):
    """Tomorrow 08:00 local, in UTC for Graph."""
    t = (now + dt.timedelta(days=1)).replace(hour=8, minute=0, second=0, microsecond=0)
    return t.astimezone(dt.timezone.utc)


def act(c, verb, mid):
    tok = access(c)
    if verb == "done":
        patch(tok, mid, {"flag": {"flagStatus": "complete"}})
        drop_cache()
        return print("flag complete")
    at = snooze_at(dt.datetime.now().astimezone())
    when = {"dateTime": at.strftime("%Y-%m-%dT%H:%M:%S"), "timeZone": "UTC"}
    patch(tok, mid, {"flag": {"flagStatus": "flagged", "startDateTime": when, "dueDateTime": when}})
    drop_cache()
    print("snoozed to " + at.astimezone().strftime("%a %H:%M"))


def thread(c, mid):
    tok = access(c)
    m = get(tok, "/me/messages/" + mid + "?$select=conversationId,subject")
    q = urllib.parse.urlencode({"$filter": f"conversationId eq '{m['conversationId']}'",
                                "$select": "from,toRecipients,ccRecipients,receivedDateTime,body,subject", "$top": "50"})
    msgs = get(tok, "/me/messages?" + q, {"Prefer": 'outlook.body-content-type="text"'})["value"]
    msgs.sort(key=lambda x: x.get("receivedDateTime", ""), reverse=True)
    addr = lambda rs: ", ".join(r["emailAddress"].get("name") or r["emailAddress"]["address"] for r in rs or [])
    print("Subject: " + (m.get("subject") or ""))
    for x in msgs:
        a = (x.get("from") or {}).get("emailAddress") or {}
        print(f"\n--- {x.get('receivedDateTime', '')[:16]} from {a.get('name', '')} <{a.get('address', '')}>")
        print("To: " + addr(x.get("toRecipients")) + (("  Cc: " + addr(x.get("ccRecipients"))) if x.get("ccRecipients") else ""))
        print((x.get("body") or {}).get("content", "").strip())


def draft(c, mid, text, reply_all):
    """A reply draft with text above the native quote. Nothing is sent."""
    tok = access(c)
    path = "/me/messages/" + mid + ("/createReplyAll" if reply_all else "/createReply")
    req = urllib.request.Request(GRAPH + path, json.dumps({"comment": text}).encode(), method="POST",
                                 headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        d = json.load(r)
    drop_cache()
    print("draft saved: " + d.get("webLink", d.get("id", "")))


def fetch(c):
    tok = access(c)
    now = dt.datetime.now().astimezone()
    day = now.replace(hour=0, minute=0, second=0, microsecond=0)
    today = events(tok, day)
    nxt = next((e for e in today if not e["all_day"] and e["start"] >= now.strftime("%Y-%m-%dT%H:%M")), None)
    if nxt:
        nxt["next"] = True
    inbox = get(tok, "/me/mailFolders/inbox?$select=unreadItemCount")
    drafts = get(tok, "/me/mailFolders/drafts?$select=totalItemCount")
    picked, answered = important(tok, c["user"])
    flagged = mark(tok, picked, answered) if c.get("mark_important") else []
    return {"at": now.isoformat(timespec="seconds"), "events": today, "tomorrow": events(tok, day + dt.timedelta(days=1)),
            "unread": inbox.get("unreadItemCount", 0), "flagged": flagged, "drafts": drafts.get("totalItemCount", 0),
            "important": picked}


def main():
    global TZ
    a = sys.argv[1:]
    c = conf()
    TZ = c.get("timezone", TZ)
    if a[:1] == ["login"]:
        return login(c)
    if a[:1] in (["done"], ["snooze"], ["thread"], ["draft"]) and len(a) < 2:
        sys.exit(__doc__)
    if a[:1] in (["done"], ["snooze"]):
        return act(c, a[0], a[1])
    if a[:1] == ["thread"]:
        return thread(c, a[1])
    if a[:1] == ["draft"]:
        return draft(c, a[1], sys.stdin.read().strip(), "--all" in a)
    if a[:1] != ["json"]:
        sys.exit(__doc__)
    if "-f" not in a and os.path.exists(CACHE) and time.time() - os.path.getmtime(CACHE) < TTL:
        print(open(CACHE).read())
        return
    data = json.dumps(fetch(c))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        f.write(data)
    print(data)


if __name__ == "__main__":
    main()

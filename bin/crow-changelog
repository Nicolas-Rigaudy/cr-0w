#!/usr/bin/env python3
"""crow-changelog: build CHANGELOG.md from changelogs/CHANGELOGS_X_Y_Z.md, newest first.

  crow-changelog            write CHANGELOG.md
  crow-changelog --check    exit 1 when CHANGELOG.md is stale or missing
  --root DIR                use DIR instead of this checkout
"""
import argparse
import re
import sys
from pathlib import Path

NAME = re.compile(r"^CHANGELOGS_(\d+)_(\d+)_(\d+)\.md$")
HEADER = "# Changelog\n\nGenerated by bin/crow-changelog from changelogs/. Do not edit.\n"


def entries(root):
    found = []
    for p in (root / "changelogs").glob("CHANGELOGS_*.md"):
        m = NAME.match(p.name)
        if m:
            found.append((tuple(int(x) for x in m.groups()), p))
    return sorted(found, reverse=True)


def aggregate(root):
    out = HEADER
    for ver, p in entries(root):
        body = p.read_text(encoding="utf-8").strip()
        out += f"\n## {'.'.join(map(str, ver))}\n\n{body}\n"
    return out


def main(argv=None):
    ap = argparse.ArgumentParser(prog="crow-changelog", description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--root", default=str(Path(__file__).resolve().parent.parent))
    a = ap.parse_args(argv)
    root = Path(a.root).resolve()
    want, target = aggregate(root), root / "CHANGELOG.md"
    if a.check:
        if not target.is_file() or target.read_text(encoding="utf-8") != want:
            print("CHANGELOG.md is stale: run bin/crow-changelog", file=sys.stderr)
            return 1
        return 0
    target.write_text(want, encoding="utf-8")
    print(f"wrote {target} ({len(entries(root))} release(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())

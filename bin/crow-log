#!/usr/bin/env python3
"""Append one activity line to today's daily note under '## CR-0W', no model call.

Usage: crow-log "[tag] text" [--date YYYY-MM-DD]

Writes '- HH:MM [tag] text' at the end of the CR-0W section (added before End of day
when missing). A missing daily is created from the vault template when it only uses
date calls. With no vault, or a template crow cannot fill, the line goes to
local/state/activity/<date>.md instead. The rest of the note stays byte-identical.
"""
import argparse
import datetime as dt
import fcntl
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import crow_lib  # noqa: E402
from crow_vault import CROW, EOD, TEMPLATE, daily_path, known_template, render_template, section_bounds, vault_path  # noqa: E402


def insert(text, entry):
    lines = text.split("\n")
    bounds = section_bounds(lines, CROW)
    if bounds is None:
        eod = section_bounds(lines, EOD)
        at = eod[0] - 1 if eod else len(lines)
        block = [f"## {CROW}", entry, ""]
        if at == len(lines) and lines and lines[-1] == "":
            at -= 1
            block = ["", f"## {CROW}", entry]
        elif at > 0 and lines[at - 1].strip():
            block = [""] + block
        lines[at:at] = block
    else:
        start, end = bounds
        body = lines[start:end]
        last = max((i for i, l in enumerate(body) if l.strip()), default=None)
        lines.insert(start + (last + 1 if last is not None else 0), entry)
    return "\n".join(lines)


def write_atomic(path, text):
    tmp = path.with_name(f".{path.name}.crow-tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def fallback(day, entry):
    path = crow_lib.machine_dir() / "activity" / f"{day.isoformat()}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(entry + "\n")
    return path


def log(day, entry):
    vault = vault_path()
    if vault is None or not vault.is_dir():
        return fallback(day, entry)
    path = daily_path(vault, day)
    if path.exists():
        text = path.read_text()
    else:
        tpl = vault / TEMPLATE
        raw = tpl.read_text() if tpl.exists() else None
        if raw is None or not known_template(raw):
            return fallback(day, entry)
        text = render_template(raw, day)
        path.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(path, insert(text, entry))
    return path


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("text", nargs="+")
    ap.add_argument("--date", default=None)
    args = ap.parse_args()
    day = dt.date.fromisoformat(args.date) if args.date else dt.date.today()
    entry = f"- {dt.datetime.now():%H:%M} {' '.join(args.text)}"
    lock = crow_lib.machine_dir() / "crow-log.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    with open(lock, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        path = log(day, entry)
    print(f"logged in {path}")


if __name__ == "__main__":
    main()

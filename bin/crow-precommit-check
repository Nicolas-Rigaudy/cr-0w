#!/usr/bin/env bash
# crow-precommit-check: git pre-commit hook that refuses staged added lines matching the push deny list,
# so a private name is caught at commit time and never enters history (the pre-push check cannot clear it later).
# Patterns come from local/prepush-deny.txt plus local/prepush-deny.<repo-dir-name>.txt (same as crow-prepush-check).
# Install: ln -s <crow>/bin/crow-precommit-check <repo>/.git/hooks/pre-commit
set -u
main="$(dirname "$(realpath "$(git rev-parse --git-common-dir)")")"   # main checkout, so a linked worktree finds local/
repo="$(basename "$main")"
CROW_HOME="$main"
pats=$(cat "$CROW_HOME/local/prepush-deny.txt" "$CROW_HOME/local/prepush-deny.$repo.txt" 2>/dev/null | grep -v '^\s*#' | grep -v '^\s*$' | paste -sd'|')
[ -z "$pats" ] && exit 0
hits=$(git diff --cached -U0 --no-color | grep -a -E '^\+[^+]' | grep -n -i -E "$pats" | head -5)
[ -z "$hits" ] && exit 0
echo "crow-precommit-check: denied pattern in staged lines (generic files must not name private projects):" >&2
echo "$hits" | cut -c1-160 >&2
echo "Move the specifics to local/ (runbooks, notes) and keep this file generic." >&2
exit 1

#!/usr/bin/env python3
"""crow-review-run: review one MR in a read-only background run and keep its findings as JSON.

  crow-review-run start REPO NUMBER [--branch B] [--mode peer|self|threads] [--model M] [--power P] [--force]
  crow-review-run apply REPO NUMBER      resume the review session to apply the decisions (commit locally)
  crow-review-run sync REPO NUMBER       fold a finished run into the findings file (no-op otherwise)
  crow-review-run show REPO NUMBER       the findings file, synced first
  crow-review-run decide REPO NUMBER ID STATE [--note TEXT]   record the owner's decision on one finding
  crow-review-run actions REPO NUMBER    pending push and post actions, each with its exact text, command and hash
  crow-review-run act REPO NUMBER ID --hash H   run that one action (refused when it changed since shown)
  crow-review-run check FILE             validate a findings file against the schema (exit 1 on errors)

REPO is the registry remote (group/name), NUMBER the MR or PR number. The findings file is
<state>/reviews/<group>_<name>-<number>.json (schema: runbooks/review-findings.md).

start writes a context bundle (MR threads, diff, review ledgers) under the repo's git dir, then
dispatches `crow-runs dispatch --permission review` (Claude plan mode: no edits, no writes). The run
prints its findings as one JSON object in its final message; sync parses it, validates it and writes
the file. Nothing is posted, pushed or committed.

With --branch, the run works in a worktree <repo path>.wt/review-<number> detached on the MR's source
branch. apply resumes that conversation (cdx --continue-run) in the same worktree with write rights:
it fixes accepted and edited findings (self mode), answers chat notes, commits locally and never pushes.

actions and act are the only commands that leave the machine. Self mode: one push of the apply commit
to the MR branch (fast-forward only). Peer mode: one comment per accepted or edited finding, on its
diff line when it has one. Threads mode (the owner's MR, reviewers' open threads): one finding per
thread with a proposed fix and reply; actions push the fix, then reply to and resolve each accepted
thread. act runs exactly the command actions showed, one action per call.
"""
import argparse, hashlib, json, os, pwd, re, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote

import yaml

BIN = Path(os.path.dirname(os.path.realpath(__file__)))
HOME = Path(os.environ.get("CROW_HOME") or BIN.parent)

SCHEMA = 1
SEVERITIES = ("blocking", "suggestion", "nit", "question")
STATES = ("pending", "accepted", "refused", "edited", "chat")
RUN_STATES = ("running", "done", "failed")
APPLY_STATUSES = ("fixed", "answered", "skipped", "failed")
MODES = ("peer", "self", "threads")
AGREE = ("yes", "no", "partly")
DEFAULT_MODEL = "opus"


def registry():
    try:
        return yaml.safe_load(open(HOME / "local" / "projects.yaml")) or {}
    except FileNotFoundError:
        return {}


def state_dir():
    return Path((registry().get("vault") or {}).get("crow_dir") or HOME / "local" / "state")


def findings_path(repo, number):
    return state_dir() / "reviews" / f"{repo.replace('/', '_')}-{number}.json"


def project_of(repo):
    p = next((p for p in registry().get("projects") or [] if p.get("remote") == repo), None)
    if not p:
        sys.exit(f"crow-review-run: {repo} is not a registered remote")
    return p


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ---------- schema ----------

def validate_finding(f, i):
    where = f"findings[{i}]"
    errs = []
    if not isinstance(f, dict):
        return [f"{where}: not an object"]
    for k in ("title", "body"):
        if not isinstance(f.get(k), str) or not f[k].strip():
            errs.append(f"{where}.{k}: required non-empty string")
    for k in ("path", "comment", "fix", "pattern", "test", "how"):
        if k in f and f[k] is not None and not isinstance(f[k], str):
            errs.append(f"{where}.{k}: must be a string")
    if "line" in f and f["line"] is not None and (not isinstance(f["line"], int) or isinstance(f["line"], bool) or f["line"] < 0):
        errs.append(f"{where}.line: must be a non-negative integer")
    if f.get("severity") not in SEVERITIES:
        errs.append(f"{where}.severity: one of {', '.join(SEVERITIES)}")
    return errs


def validate_output(doc):
    """Errors in the object a review run prints (an empty list when it is valid)."""
    if not isinstance(doc, dict):
        return ["output: not a JSON object"]
    errs = []
    if not isinstance(doc.get("summary", ""), str):
        errs.append("summary: must be a string")
    if not isinstance(doc.get("findings"), list):
        return errs + ["findings: required list"]
    for i, f in enumerate(doc["findings"]):
        errs += validate_finding(f, i)
    return errs


def validate_file(doc):
    """Errors in a findings file (an empty list when it is valid)."""
    if not isinstance(doc, dict):
        return ["file: not a JSON object"]
    errs = []
    if doc.get("schema") != SCHEMA:
        errs.append(f"schema: must be {SCHEMA}")
    for k in ("repo", "project"):
        if not isinstance(doc.get(k), str) or not doc[k]:
            errs.append(f"{k}: required string")
    if not isinstance(doc.get("number"), int):
        errs.append("number: required integer")
    if doc.get("mode") not in MODES:
        errs.append(f"mode: one of {', '.join(MODES)}")
    run = doc.get("run")
    if not isinstance(run, dict) or run.get("state") not in RUN_STATES:
        errs.append(f"run.state: one of {', '.join(RUN_STATES)}")
    elif run["state"] == "failed" and not run.get("reason"):
        errs.append("run.reason: required when the run failed")
    ap = doc.get("apply")
    if ap is not None:
        if not isinstance(ap, dict) or ap.get("state") not in RUN_STATES:
            errs.append(f"apply.state: one of {', '.join(RUN_STATES)}")
        elif ap["state"] == "failed" and not ap.get("reason"):
            errs.append("apply.reason: required when the apply run failed")
    if not isinstance(doc.get("findings"), list):
        return errs + ["findings: required list"]
    ids = set()
    for i, f in enumerate(doc["findings"]):
        errs += validate_finding(f, i)
        if isinstance(f, dict):
            if f.get("state") not in STATES:
                errs.append(f"findings[{i}].state: one of {', '.join(STATES)}")
            res = f.get("apply")
            if res is not None and (not isinstance(res, dict) or res.get("status") not in APPLY_STATUSES):
                errs.append(f"findings[{i}].apply.status: one of {', '.join(APPLY_STATUSES)}")
            if not f.get("id") or f["id"] in ids:
                errs.append(f"findings[{i}].id: required and unique")
            ids.add(f.get("id"))
            if doc.get("mode") == "threads" and not (isinstance(f.get("thread"), dict) and f["thread"].get("id")):
                errs.append(f"findings[{i}].thread.id: required in threads mode")
    return errs


def parse_output(text):
    """The findings object in a run's final message: the whole text, the last ```json block, or the outer braces."""
    text = (text or "").strip()
    candidates = [text]
    candidates += reversed(re.findall(r"```(?:json)?\s*\n(.*?)\n```", text, re.S))
    if "{" in text:
        candidates.append(text[text.index("{"):text.rindex("}") + 1])
    for c in candidates:
        try:
            doc = json.loads(c)
        except ValueError:
            continue
        if isinstance(doc, dict) and "findings" in doc:
            return doc
    return None


def to_findings(doc, threads=None):
    """Run output findings, with an id, defaults and the pending decision state. In threads mode each
    finding carries its forge thread (matched on the T<n> key the bundle gave it); one with an unknown
    key is dropped."""
    by_key = {t["key"]: t for t in threads or []}
    out = []
    for i, f in enumerate(doc["findings"], 1):
        extra = {}
        if threads is not None:
            t = by_key.get(str(f.get("thread") or "").strip())
            if t is None:
                continue
            extra = {"thread": {k: t.get(k) for k in ("key", "id", "comment_id", "author", "body", "path", "line")},
                     "agree": f.get("agree") if f.get("agree") in AGREE else "yes",
                     "test": (f.get("test") or "").strip(),
                     "pattern_kind": f.get("pattern_kind") if f.get("pattern_kind") in ("repeat", "new") else "",
                     "how": (f.get("how") or "").strip()}
        out.append({
            "id": f"f{i}", "title": f["title"].strip(), "severity": f["severity"],
            "path": f.get("path") or "", "line": f.get("line") or 0,
            "body": f["body"].strip(), "comment": (f.get("comment") or "").strip(),
            "fix": (f.get("fix") or "").strip(), "pattern": f.get("pattern") or "",
            "seen": f.get("seen") if isinstance(f.get("seen"), int) else 0,
            "state": "pending", "note": "", **extra,
        })
    for i, f in enumerate(out, 1):
        f["id"] = f"f{i}"
    return out


# ---------- files ----------

def load(path):
    try:
        return json.loads(Path(path).read_text())
    except (FileNotFoundError, ValueError):
        return None


def save(path, doc):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(doc, indent=1, ensure_ascii=False) + "\n")
    tmp.replace(path)


def decided(doc):
    return [f for f in (doc or {}).get("findings") or [] if isinstance(f, dict) and f.get("state", "pending") != "pending"]


# ---------- start ----------

def sh(*args, cwd=None):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def mr_detail(repo, number):
    """Diff and threads from crow-mrs (GET requests only)."""
    r = subprocess.run([str(BIN / "crow-mrs"), "show", repo, str(number)], capture_output=True, text=True, timeout=120)
    if r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else "crow-mrs failed")
    return json.loads(r.stdout)


def ledgers(project_path):
    """The review ledgers that apply: common.md and the one named after the repo dir."""
    d = HOME / "local" / "reviews"
    out = []
    for name in ("common.md", f"{Path(project_path).name}.md"):
        f = d / name
        if f.exists():
            out.append((name, f.read_text()))
    return out


def open_threads(detail):
    """The unresolved threads of an MR, keyed T1..Tn in the order the forge lists them."""
    out = [t for t in detail.get("threads") or [] if not t.get("resolved") and t.get("id")]
    return [{**t, "key": f"T{i}"} for i, t in enumerate(out, 1)]


def bundle_text(repo, number, mode, detail, ledger_files):
    parts = [f"# Review bundle: {repo} !{number} ({mode} review)\n"]
    for name, text in ledger_files:
        parts.append(f"## Ledger {name}\n\n{text.strip()}\n")
    threads = detail.get("threads") or []
    if mode == "threads":
        todo = open_threads(detail)
        parts.append(f"## Open threads to answer ({len(todo)})\n")
        for t in todo:
            parts.append(f"### {t['key']}: {t.get('author', '')} on {t.get('path') or 'the MR'}:{t.get('line') or 0}\n\n{(t.get('body') or '').strip()}\n")
    parts.append(f"## Existing threads ({len(threads)})\n")
    for t in threads:
        state = "resolved" if t.get("resolved") else "open"
        parts.append(f"- [{state}] {t.get('author', '')} on {t.get('path') or '-'}:{t.get('line') or 0}: {(t.get('body') or '').strip()}")
    files = detail.get("files") or []
    parts.append(f"\n## Diff ({len(files)} files)\n")
    for f in files:
        parts.append(f"### {f['path']} (+{f.get('add', 0)} -{f.get('del', 0)})\n\n```diff\n{f.get('diff', '').rstrip()}\n```\n")
    return "\n".join(parts)


def bundle_path(project_path, number, wt=None):
    """Inside the run's cwd and outside git status: under the repo's git dir for a run in the main
    checkout, under <worktree>/.crow-review/ (listed in info/exclude) for a run in a worktree."""
    common = sh("git", "rev-parse", "--path-format=absolute", "--git-common-dir", cwd=project_path)
    base = Path(common) if common else Path(project_path) / ".git"
    if not wt:
        return base / "crow-review" / f"{number}.md"
    exclude = base / "info" / "exclude"
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    if "/.crow-review/" not in lines:
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text("\n".join(lines + ["/.crow-review/"]) + "\n")
    return Path(wt) / ".crow-review" / f"{number}.md"


def threads_prompt(repo, number, bundle):
    return f"""Read-only pass over the reviewers' open threads on {repo} !{number}, the owner's own MR. You run in plan mode: do not edit, write or run anything that changes state.

1. Read the bundle {bundle}: the review ledgers, the open threads (T1, T2, ...) and the full diff.
2. Follow the review-threads skill for each open thread: check the claim in the code (neighbours too) before agreeing; search the repo for how it already handles the same case; disagree when the reviewer is wrong and say why. Match each thread against the ledgers: a known row is a repeat, else a new pattern. A fix covers every other occurrence of the same problem in the MR.
3. Read around the changes in this checkout. The bundle diff is the source of truth. If a command is denied, carry on with the bundle.

Reply rules (the skill's): a thread the fix fully answers gets NO reply (empty comment), it is resolved silently. Write a reply only when there is no change (disagreement, explanation, answer to a question) or it adds something the diff does not show. Reply in the reviewer's language, 1 to 3 short declarative sentences, never "done"/"fait". No AI attribution.

Your final message is ONE JSON object and nothing else, one finding per open thread:
{{"summary": "Threads: N open, K fixes, R replies. Patterns: X repeats, Y new.",
  "findings": [{{"thread": "T1", "title": "short title of the problem",
    "severity": "blocking|suggestion|nit|question (the kind of comment the reviewer left)",
    "agree": "yes|no|partly", "path": "file path, empty when MR-level", "line": 0,
    "body": "what is actually wrong (or why the reviewer is wrong), one or two sentences",
    "comment": "the reply to post, empty when the fix speaks for itself",
    "fix": "the proposed fix: a short unified diff, empty for reply only",
    "test": "the test change that proves the fix, a short unified diff or empty",
    "pattern": "the ledger row title for a repeat, or a short name for a new pattern, empty when none",
    "pattern_kind": "repeat|new or empty", "how": "for a new pattern: how to catch it on the diff, one line",
    "seen": 0}}]}}
"""


def prompt_text(repo, number, mode, bundle):
    if mode == "threads":
        return threads_prompt(repo, number, bundle)
    return f"""Read-only review of {repo} !{number} ({mode} mode). You run in plan mode: do not edit, write or run anything that changes state.

1. Read the bundle {bundle}: the review ledgers, the existing threads and the full diff.
2. Follow the review skill checks: the repo's own review skill if it has one (.claude/skills/*review*), then every ledger row against the diff, then correctness, failure paths, tests.
3. Read around the changes in this checkout for context (callers, siblings). The checkout may sit on another branch: the bundle diff is the source of truth. If a command is denied, carry on with the bundle.

Your final message is ONE JSON object and nothing else:
{{"summary": "Patterns: N checked, K hits, M n/a. <one-line verdict>",
  "findings": [{{"title": "short title", "severity": "blocking|suggestion|nit|question",
    "path": "file path from the diff, empty for a commit or MR-level finding", "line": 0,
    "body": "the problem, one or two sentences",
    "comment": "the review comment ready to post, in the repo's review language and style",
    "fix": "the proposed fix: a short unified diff or exact replacement",
    "pattern": "ledger row title when a ledger row hit, else empty", "seen": 0}}]}}
line is the new-file line number in the diff. seen is the ledger row's hit count when known. No AI attribution in any text.
"""


def start(a):
    p = project_of(a.repo)
    path = findings_path(a.repo, a.number)
    old = load(path)
    if old and (old.get("run") or {}).get("state") == "running" and not a.force:
        sys.exit(f"crow-review-run: a review of {a.repo} !{a.number} is already running; --force to restart")
    if decided(old) and not a.force:
        sys.exit(f"crow-review-run: {len(decided(old))} findings already have a decision; --force to start over")
    if old and (old.get("apply") or {}).get("state") == "running":
        sys.exit(f"crow-review-run: an apply run on {a.repo} !{a.number} is still running")
    detail = mr_detail(a.repo, a.number)
    # The deck picks the mode from an MR list fetched earlier: threads posted since then must not get a self review.
    if a.mode == "self" and open_threads(detail):
        print(f"crow-review-run: {a.repo} !{a.number} has {len(open_threads(detail))} open threads, answering them (threads mode)")
        a.mode = "threads"
    threads = open_threads(detail) if a.mode == "threads" else None
    if threads is not None and not threads:
        sys.exit(f"crow-review-run: {a.repo} !{a.number} has no open thread to answer")
    wt = review_worktree(p["path"], a.number, a.branch, a.force) if a.branch else None
    bundle = bundle_path(p["path"], a.number, wt)
    bundle.parent.mkdir(parents=True, exist_ok=True)
    bundle.write_text(bundle_text(a.repo, a.number, a.mode, detail, ledgers(p["path"])))
    prompt = path.with_suffix(".prompt.md")
    prompt.parent.mkdir(parents=True, exist_ok=True)
    prompt.write_text(prompt_text(a.repo, a.number, a.mode, bundle))
    run_id = dispatch(p["name"], f"review-{a.number}", prompt, a.model, a.power, cwd=wt)
    doc = {"schema": SCHEMA, "repo": a.repo, "number": a.number, "project": p["name"], "mode": a.mode,
           "branch": a.branch or "", "worktree": str(wt or ""),
           "run": {"id": run_id, "state": "running", "reason": "", "model": a.model,
                   "started_at": now(), "ended_at": ""},
           "summary": "", "findings": []}
    if threads is not None:
        doc["threads"] = [{k: t.get(k) for k in ("key", "id", "comment_id", "author", "body", "path", "line")} for t in threads]
    save(path, doc)
    print(f"review {run_id[:8]} started for {a.repo} !{a.number}; findings go to {path}")


def git(*args, cwd):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def review_worktree(project_path, number, branch, force=False):
    """<path>.wt/review-<number>, detached on origin/<branch> (fetched). An existing one is moved to the
    branch's tip unless it holds changes or local commits (apply output not pushed yet)."""
    wt = Path(f"{project_path}.wt") / f"review-{number}"
    r = git("fetch", "origin", branch, cwd=project_path)
    if r.returncode:
        sys.exit(f"crow-review-run: git fetch origin {branch} failed: {(r.stderr.strip().splitlines() or ['?'])[-1]}")
    tip = sh("git", "rev-parse", "FETCH_HEAD", cwd=project_path)
    if wt.exists():
        if not force:
            if sh("git", "status", "--porcelain", cwd=wt):
                sys.exit(f"crow-review-run: {wt} has uncommitted changes; --force to start over")
            if sh("git", "log", "--oneline", f"origin/{branch}..HEAD", cwd=wt):
                sys.exit(f"crow-review-run: {wt} holds local commits not on origin/{branch}; push them or --force")
        r = git("checkout", "--force", "--detach", tip, cwd=wt)
    else:
        wt.parent.mkdir(parents=True, exist_ok=True)
        r = git("worktree", "add", "--detach", str(wt), tip, cwd=project_path)
    if r.returncode:
        sys.exit(f"crow-review-run: worktree {wt}: {(r.stderr.strip().splitlines() or ['?'])[-1]}")
    return wt


def dispatch(project, label, prompt, model, power, cwd=None, continue_run=None, permission="review"):
    """crow-runs dispatch (review permission unless told); returns the full run id.
    With continue_run, cdx pins the parent's model and effort, so none are passed."""
    args = [str(BIN / "crow-runs"), "dispatch", project, label, "--prompt-file", str(prompt)]
    args += ["--continue-run", continue_run] if continue_run else ["--model", model, "--power", power]
    args += ["--permission", permission] if permission else []
    args += ["--cwd", str(cwd)] if cwd else []
    r = subprocess.run(args, capture_output=True, text=True)
    m = re.search(r"^dispatched (\S+)", r.stdout, re.M)
    if r.returncode or not m:
        sys.exit((r.stderr or r.stdout).strip() or "crow-review-run: dispatch failed")
    try:
        rows = [json.loads(l) for l in (state_dir() / "runs.jsonl").read_text().splitlines() if l.strip()]
    except FileNotFoundError:
        rows = []
    return next((x["run_id"] for x in reversed(rows) if x["run_id"].startswith(m.group(1))), m.group(1))


# ---------- sync ----------

def cdx_run(run_id):
    """The cdx row of a run (None when cdx does not know it)."""
    # The --since list leaves running runs out; --running lists them.
    for args in (("--since", "7d", "--limit", "200"), ("--running",)):
        out = sh("cdx", "runs", *args, "--json")
        rows = json.loads(out).get("runs", []) if out else []
        row = next((r for r in rows if r.get("run_id", "").startswith(run_id)), None)
        if row:
            return row
    return None


def final_message(row):
    rep = sh("cdx", "run-report", row["run_id"], "--json")
    final = (json.loads(rep).get("report", {}) if rep else {}).get("final_message")
    if final:
        return final
    sys.path.insert(0, str(BIN))
    import crow_lib
    f = Path((row.get("artifacts") or {}).get("stdout_path") or "/nonexistent")
    return crow_lib.final_text(f.read_text(errors="replace"), row.get("provider") or "claude") if f.exists() else ""


def fold(doc, row, text):
    """Fold a finished cdx run row and its final message into the findings doc."""
    run = doc["run"]
    run["ended_at"] = row.get("ended_at") or now()
    if row.get("exit_code") != 0:
        tail = (text or "").strip().splitlines()
        run.update(state="failed", reason=f"run exited {row.get('exit_code')}: {tail[-1][:200] if tail else 'no output'}")
        return doc
    out = parse_output(text)
    if out is None:
        run.update(state="failed", reason="no findings JSON in the run's final message")
        return doc
    errs = validate_output(out)
    if errs:
        run.update(state="failed", reason="invalid findings: " + "; ".join(errs[:3]))
        return doc
    run.update(state="done", reason="")
    doc["summary"] = (out.get("summary") or "").strip()
    doc["findings"] = to_findings(out, doc.get("threads") if doc.get("mode") == "threads" else None)
    return doc


def sync(repo, number, lookup=None, message=None, checks=None):
    """Fold the review run, then the apply run, when cdx reports them finished."""
    lookup, message = lookup or cdx_run, message or final_message
    path = findings_path(repo, number)
    doc = load(path)
    if not isinstance(doc, dict):
        return doc
    changed = False
    for key, folder in (("run", fold), ("apply", lambda d, row, text: fold_apply(d, row, text, checks or apply_checks))):
        run = doc.get(key) or {}
        if run.get("state") != "running":
            continue
        row = lookup(run["id"])
        if row is None:
            run.update(state="failed", reason="cdx does not know this run", ended_at=now())
        elif not row.get("ended_at"):
            continue
        else:
            folder(doc, row, message(row))
        changed = True
    if changed:
        save(path, doc)
    return doc


# ---------- apply ----------

def todo(doc):
    """Findings the apply run acts on: chat notes in any mode, accepted and edited ones in self mode,
    accepted and edited threads that carry a fix in threads mode (edited there means the reply was
    rewritten). A finding already handled for the same decision and note is left out."""
    mode = doc.get("mode")
    def wanted(f):
        if f.get("state") == "chat":
            return True
        if f.get("state") not in ("accepted", "edited"):
            return False
        return mode == "self" or (mode == "threads" and bool(f.get("fix")))
    return [f for f in doc.get("findings") or []
            if wanted(f) and (f.get("apply") or {}).get("for") != [f["state"], f.get("note", "")]]


def apply_prompt(doc, items):
    lines = []
    threads = doc.get("mode") == "threads"
    for f in items:
        where = f"{f.get('path') or 'MR'}:{f.get('line') or 0}"
        what = {"accepted": "apply your proposed fix" + (" and its test" if threads else ""),
                "edited": "apply your proposed fix and its test (the owner only rewrote the reply)" if threads
                          else "apply the fix the owner's note asks for",
                "chat": "answer the owner's note, change no code"}[f["state"]]
        note = f.get("note") if f["state"] == "chat" or not threads else ""
        lines.append(f"- {f['id']} [{f['state']}] {f['title']} ({where}): {what}." + (f"\n  Owner's note: {note}" if note else ""))
    skipped = [f["id"] for f in doc.get("findings") or [] if f not in items]
    return f"""Apply phase of your review of {doc['repo']} !{doc['number']} ({doc['mode']} mode). This is the same conversation: your findings f1..f{len(doc.get('findings') or [])} are above.
You now have write rights in this worktree ({doc.get('worktree') or 'the current folder'}) and nowhere else.

First check that this conversation holds your review (the bundle and your findings). If it does not, change nothing and answer {{"context": "lost"}}.

The owner's decisions:
{chr(10).join(lines)}
Leave every other finding alone ({', '.join(skipped) or 'none'}).

Rules:
- Change only what these findings need, plus their tests. Run the tests that cover the change when the repo has them.
- One local commit for all code changes. Subject `type[SCOPE]: message`: type new|chg|fix, SCOPE the file kinds touched, uppercase, '/'-separated (e.g. `fix[PY/MD]: paginate the list call`). English. No trailers, no AI attribution.
- Never push, never post to the forge, never touch another folder.
- Answer chat notes in the note's language, short and declarative. Chat findings get no code change.

Your final message is ONE JSON object and nothing else:
{{"context": "ok", "commit": "full sha or empty when no code changed", "subject": "the commit subject or empty",
  "results": [{{"id": "f1", "status": "fixed|answered|skipped|failed", "detail": "what changed, or the answer to the note, or why not"}}]}}
One result per finding listed above.
"""


def parse_apply(text):
    text = (text or "").strip()
    candidates = [text, *reversed(re.findall(r"```(?:json)?\s*\n(.*?)\n```", text, re.S))]
    if "{" in text:
        candidates.append(text[text.index("{"):text.rindex("}") + 1])
    for c in candidates:
        try:
            doc = json.loads(c)
        except ValueError:
            continue
        if isinstance(doc, dict) and "context" in doc:
            return doc
    return None


def apply_checks(doc, commit):
    """Warnings on the apply commit, read from the worktree: format, files outside the findings, pushed."""
    wt = doc.get("worktree")
    if not commit or not wt or not Path(wt).is_dir():
        return [], ""
    subject = sh("git", "log", "-1", "--format=%s", commit, cwd=wt)
    if not subject:
        return [f"commit {commit[:8]} is not in {wt}"], ""
    warn = []
    chk = subprocess.run([str(BIN / "crow-commit-msg-check"), "-"], input=subject, capture_output=True, text=True)
    if chk.returncode:
        warn.append(f"subject is not type[SCOPE]: {subject}")
    allowed = {f.get("path") for f in doc.get("findings") or [] if f.get("state") in ("accepted", "edited") and f.get("path")}
    files = sh("git", "diff-tree", "--no-commit-id", "--name-only", "-r", commit, cwd=wt).splitlines()
    extra = [x for x in files if x not in allowed and not re.search(r"(^|/)(tests?|spec)(/|_)|_test\.|\.test\.|test_", x)]
    if extra:
        warn.append("files outside the accepted findings: " + ", ".join(extra))
    if doc.get("branch") and sh("git", "branch", "-r", "--contains", commit, cwd=wt):
        warn.append(f"commit {commit[:8]} is already on a remote branch")
    return warn, subject


def fold_apply(doc, row, text, checks=apply_checks):
    """Fold a finished apply run: results onto the findings, the commit and its warnings on doc.apply."""
    ap = doc["apply"]
    ap["ended_at"] = row.get("ended_at") or now()
    if row.get("exit_code") != 0:
        tail = (text or "").strip().splitlines()
        ap.update(state="failed", reason=f"apply run exited {row.get('exit_code')}: {tail[-1][:200] if tail else 'no output'}")
        return doc
    out = parse_apply(text)
    if out is None:
        ap.update(state="failed", reason="no result JSON in the apply run's final message")
        return doc
    if out.get("context") != "ok":
        ap.update(state="failed", reason="the resumed session lost the review context; nothing was applied. r runs the review again")
        return doc
    asked = {i: d for i, d in (ap.get("asked") or {}).items()}
    by_id = {f["id"]: f for f in doc["findings"]}
    for res in out.get("results") or []:
        f = by_id.get(res.get("id")) if isinstance(res, dict) else None
        if f is None or res.get("status") not in APPLY_STATUSES:
            continue
        f["apply"] = {"status": res["status"], "detail": str(res.get("detail") or "").strip(),
                      "for": asked.get(f["id"], [f["state"], f.get("note", "")]), "run": ap["id"]}
    missing = [i for i in asked if (by_id.get(i, {}).get("apply") or {}).get("run") != ap["id"]]
    commit = str(out.get("commit") or "").strip()
    warn, subject = checks(doc, commit)
    warn += [f"no result for {', '.join(missing)}"] if missing else []
    ap.update(state="done", reason="", commit=commit, subject=subject or str(out.get("subject") or ""), warnings=warn)
    return doc


def apply(repo, number, run_dispatch=None):
    """Resume the last finished run of this review to act on the owner's decisions."""
    path = findings_path(repo, number)
    doc = sync(repo, number)
    if not isinstance(doc, dict):
        sys.exit(f"crow-review-run: no findings file for {repo} !{number}")
    if (doc.get("run") or {}).get("state") != "done":
        sys.exit(f"crow-review-run: the review of {repo} !{number} has not finished")
    prev = doc.get("apply") or {}
    if prev.get("state") == "running":
        sys.exit(f"crow-review-run: an apply run on {repo} !{number} is already running")
    if doc.get("findings") and not doc.get("worktree"):
        sys.exit("crow-review-run: this review ran in the main checkout; r runs it again in a worktree")
    items = todo(doc)
    if not items:
        what = {"self": "accepted, edited or chat", "threads": "accepted thread with a fix, or chat"}.get(
            doc.get("mode"), "chat (a peer review posts accepted findings)")
        sys.exit(f"crow-review-run: no {what} finding left to apply")
    parent = prev["id"] if prev.get("state") == "done" and prev.get("id") else doc["run"]["id"]
    prompt = path.with_name(path.stem + ".apply.md")
    prompt.write_text(apply_prompt(doc, items))
    asked = {f["id"]: [f["state"], f.get("note", "")] for f in items}
    try:
        run_id = (run_dispatch or dispatch)(doc["project"], f"apply-{number}", prompt, None, None,
                                            cwd=doc.get("worktree") or None, continue_run=parent, permission=None)
    except SystemExit as e:
        reason = str(e.code or "dispatch failed")
        if "continue_run" in reason:
            reason = "cannot resume the review session (" + reason.split("dispatch failed: ", 1)[-1] + "); r runs the review again"
        doc["apply"] = {"id": "", "state": "failed", "reason": reason, "parent": parent, "asked": asked,
                        "started_at": now(), "ended_at": now()}
        save(path, doc)
        sys.exit(f"crow-review-run: {reason}")
    doc["apply"] = {"id": run_id, "state": "running", "reason": "", "parent": parent, "asked": asked,
                    "started_at": now(), "ended_at": "", "commit": "", "subject": "", "warnings": []}
    save(path, doc)
    print(f"apply {run_id[:8]} started for {repo} !{number}: {len(items)} {'finding' if len(items) == 1 else 'findings'}, commits locally in {doc.get('worktree')}")
    return doc


def decide(repo, number, fid, state, note=""):
    """Record a decision (accepted, refused, edited, chat, pending) and its note on one finding."""
    if state not in STATES:
        sys.exit(f"crow-review-run: state must be one of {', '.join(STATES)}")
    path = findings_path(repo, number)
    doc = load(path)
    if not isinstance(doc, dict):
        sys.exit(f"crow-review-run: no findings file for {repo} !{number}")
    f = next((f for f in doc.get("findings") or [] if f.get("id") == fid), None)
    if f is None:
        sys.exit(f"crow-review-run: no finding {fid} in {repo} !{number}")
    if state in ("edited", "chat") and not note.strip():
        sys.exit(f"crow-review-run: {state} needs --note")
    f["state"], f["note"] = state, note.strip()
    save(path, doc)
    return f


# ---------- push and post ----------
# cdx remaps HOME; git, glab and gh keep their login and keys in the real one.
REAL_ENV = {**os.environ, "HOME": pwd.getpwuid(os.getuid()).pw_dir}
REF = re.compile(r"=\{(base|start|head)_sha\}$")


def forge_call(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120, env=REAL_ENV)
    if r.returncode:
        msg = (r.stderr or r.stdout).strip().splitlines()
        raise RuntimeError(msg[-1] if msg else f"exit {r.returncode}")
    return r.stdout


def comment_text(f):
    return str((f.get("note") if f.get("state") == "edited" else f.get("comment")) or "").strip()


def post_cmd(forge, repo, number, f, text):
    """The forge command for one finding: a diff-line comment when it has path and line, else a note."""
    path, ln = f.get("path"), f.get("line")
    if forge == "github":
        if path and ln:
            return ["gh", "api", "-X", "POST", f"repos/{repo}/pulls/{number}/comments", "-f", f"body={text}",
                    "-f", "commit_id={head_sha}", "-f", f"path={path}", "-F", f"line={ln}", "-f", "side=RIGHT"]
        return ["gh", "pr", "comment", str(number), "-R", repo, "--body", text]
    base = f"projects/{quote(repo, safe='')}/merge_requests/{number}"
    if path and ln:
        return ["glab", "api", "-X", "POST", f"{base}/discussions", "-f", f"body={text}", "-f", "position[position_type]=text",
                "-f", "position[base_sha]={base_sha}", "-f", "position[start_sha]={start_sha}", "-f", "position[head_sha]={head_sha}",
                "-f", f"position[old_path]={path}", "-f", f"position[new_path]={path}", "-F", f"position[new_line]={ln}"]
    return ["glab", "api", "-X", "POST", f"{base}/notes", "-f", f"body={text}"]


def actions(doc):
    """What is left to push or post, each with its exact text and command. The hash pins both."""
    acts = []
    ap = doc.get("apply") or {}
    if doc.get("mode") in ("self", "threads"):
        sha = ap.get("commit") or ""
        if ap.get("state") == "done" and sha and doc.get("branch") and doc.get("worktree") \
                and (ap.get("pushed") or {}).get("commit") != sha:
            acts.append({"id": "push", "kind": "push", "title": f"Push {sha[:8]} to origin/{doc['branch']}",
                         "text": ap.get("subject") or "", "warnings": ap.get("warnings") or [],
                         "cmd": ["git", "-C", doc["worktree"], "push", "origin", f"{sha}:refs/heads/{doc['branch']}"]})
    if doc.get("mode") == "threads":
        acts += thread_actions(doc, ap)
    elif doc.get("mode") != "self":
        forge = project_of(doc["repo"]).get("forge") or "gitlab"
        for f in doc.get("findings") or []:
            text = comment_text(f)
            if f.get("state") not in ("accepted", "edited") or f.get("posted") or not text:
                continue
            where = f"{f['path']}:{f['line']}" if f.get("path") and f.get("line") else doc["repo"] + f" !{doc['number']}"
            acts.append({"id": f"post-{f['id']}", "kind": "comment", "title": f"Comment {f['id']} on {where}",
                         "text": text, "warnings": [], "cmd": post_cmd(forge, doc["repo"], doc["number"], f, text)})
    for a in acts:
        a["hash"] = hashlib.sha256(json.dumps([a["cmd"], a["text"]], ensure_ascii=False).encode()).hexdigest()[:12]
    return acts


def thread_cmd(forge, repo, number, t, kind, text=""):
    """Reply to or resolve one forge thread."""
    if forge == "github":
        if kind == "reply":
            return ["gh", "api", "-X", "POST", f"repos/{repo}/pulls/{number}/comments/{t.get('comment_id')}/replies", "-f", f"body={text}"]
        return ["gh", "api", "graphql", "-f", "query=mutation($id:ID!){resolveReviewThread(input:{threadId:$id}){thread{isResolved}}}",
                "-F", f"id={t['id']}"]
    base = f"projects/{quote(repo, safe='')}/merge_requests/{number}/discussions/{t['id']}"
    if kind == "reply":
        return ["glab", "api", "-X", "POST", f"{base}/notes", "-f", f"body={text}"]
    return ["glab", "api", "-X", "PUT", base, "-f", "resolved=true"]


def thread_actions(doc, ap):
    """Per accepted or edited thread: its reply (when it has text), then resolve. A thread whose fix is not
    pushed yet waits; a thread the run disagreed with gets its reply but stays open for the reviewer."""
    forge = project_of(doc["repo"]).get("forge") or "gitlab"
    pushed = bool(ap.get("commit")) and (ap.get("pushed") or {}).get("commit") == ap.get("commit")
    acts = []
    for f in doc.get("findings") or []:
        t = f.get("thread") or {}
        if f.get("state") not in ("accepted", "edited") or not t.get("id"):
            continue
        if f.get("fix") and not ((f.get("apply") or {}).get("status") == "fixed" and pushed):
            continue
        who = f"{t.get('author') or 'reviewer'} on {t.get('path') or 'the MR'}" + (f":{t['line']}" if t.get("line") else "")
        text = comment_text(f)
        if text and not f.get("posted"):
            acts.append({"id": f"reply-{f['id']}", "kind": "reply", "title": f"Reply to {who}", "text": text,
                         "warnings": [], "cmd": thread_cmd(forge, doc["repo"], doc["number"], t, "reply", text)})
        if not f.get("resolved") and f.get("agree") != "no":
            acts.append({"id": f"resolve-{f['id']}", "kind": "resolve", "title": f"Resolve the thread of {who}",
                         "text": (t.get("body") or "").strip(), "warnings": [],
                         "cmd": thread_cmd(forge, doc["repo"], doc["number"], t, "resolve")})
    return acts


# ---------- ledgers ----------

def table_cells(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def feed_ledger(doc, f):
    """Count a resolved thread in the review ledgers, as the review-threads skill does: a repeat bumps
    its row (project ledger, then common.md), a new pattern gets a row in the project ledger."""
    name = (f.get("pattern") or "").strip()
    if not name or f.get("agree") == "no" or f.get("ledger"):
        return ""
    p = project_of(doc["repo"])
    short = (p.get("aliases") or [p["name"]])[0]
    ref = f"!{doc['number']}"
    d = HOME / "local" / "reviews"
    own = d / f"{Path(p.get('path') or p['name']).name}.md"
    for path, seen in ((own, ref), (d / "common.md", f"{short} {ref}")):
        if not path.exists():
            continue
        lines = path.read_text().splitlines()
        for i, l in enumerate(lines):
            c = table_cells(l) if l.lstrip().startswith("|") else []
            if len(c) >= 3 and c[0].lower() == name.lower() and c[1].isdigit():
                c[1] = str(int(c[1]) + 1)
                if ref not in c[2]:
                    c[2] = (c[2] + (", " if path == own else " ") + seen).strip(", ")
                lines[i] = "| " + " | ".join(c) + " |"
                path.write_text("\n".join(lines) + "\n")
                f["ledger"] = f"bumped in {path.name}"
                return f["ledger"]
    row = f"| {name} | 1 | {ref} | {(f.get('how') or '').strip() or 'to write'} |"
    if not own.exists():
        own.parent.mkdir(parents=True, exist_ok=True)
        own.write_text(f"# Recurring review comments on {p['name']}\n\n| Pattern | Count | MRs | How to catch it |\n|---|---|---|---|\n")
    lines = own.read_text().splitlines()
    last = max((i for i, l in enumerate(lines) if l.lstrip().startswith("|")), default=len(lines) - 1)
    lines.insert(last + 1, row)
    own.write_text("\n".join(lines) + "\n")
    f["ledger"] = f"added to {own.name}"
    return f["ledger"]


def diff_refs(forge, repo, number, call):
    if forge == "github":
        return {"head": json.loads(call(["gh", "pr", "view", str(number), "-R", repo, "--json", "headRefOid"]))["headRefOid"]}
    d = json.loads(call(["glab", "api", f"projects/{quote(repo, safe='')}/merge_requests/{number}"]))["diff_refs"]
    return {"base": d["base_sha"], "start": d["start_sha"], "head": d["head_sha"]}


def act(repo, number, aid, expect, call=None):
    """Run one action from `actions`, only if it is unchanged since it was shown, and record it."""
    call = call or forge_call
    path = findings_path(repo, number)
    doc = sync(repo, number)
    if not isinstance(doc, dict):
        sys.exit(f"crow-review-run: no findings file for {repo} !{number}")
    a = next((a for a in actions(doc) if a["id"] == aid), None)
    if a is None:
        sys.exit(f"crow-review-run: {aid} is no longer pending on {repo} !{number}")
    if a["hash"] != expect:
        sys.exit(f"crow-review-run: {aid} changed since it was shown; P shows it again")
    cmd = a["cmd"]
    try:
        if any(REF.search(x) for x in cmd):
            refs = diff_refs(project_of(repo).get("forge") or "gitlab", repo, number, call)
            wt = doc.get("worktree")
            tip = sh("git", "rev-parse", "HEAD", cwd=wt) if wt and Path(wt).is_dir() else ""
            if tip and refs["head"] != tip:
                sys.exit(f"crow-review-run: the MR moved since the review ({refs['head'][:8]}, reviewed {tip[:8]}); "
                         "r reviews it again before posting")
            cmd = [x if x.startswith("body=") else REF.sub(lambda m: "=" + refs[m.group(1)], x) for x in cmd]
        out = call(cmd)
    except (RuntimeError, KeyError, ValueError) as e:
        sys.exit(f"crow-review-run: {aid} failed: {e}")
    doc = load(path)
    if a["kind"] == "push":
        doc["apply"]["pushed"] = {"commit": doc["apply"]["commit"], "at": now()}
        msg = f"pushed {doc['apply']['commit'][:8]} to origin/{doc['branch']}"
    elif a["kind"] in ("reply", "resolve"):
        f = next(f for f in doc["findings"] if f"{a['kind']}-{f['id']}" == aid)
        if a["kind"] == "reply":
            try:
                ref = str((json.loads(out) or {}).get("id") or "")
            except (ValueError, AttributeError):
                ref = ""
            f["posted"] = {"at": now(), "text": a["text"], "ref": ref}
            msg = f"replied on {f['id']}"
        else:
            f["resolved"] = {"at": now()}
            led = feed_ledger(doc, f)
            msg = f"resolved {f['id']}" + (f"; pattern {led}" if led else "")
    else:
        f = next(f for f in doc["findings"] if f"post-{f['id']}" == aid)
        try:
            ref = str((json.loads(out) or {}).get("id") or "")
        except (ValueError, AttributeError):
            ref = (out or "").strip().splitlines()[-1][:200] if (out or "").strip() else ""
        f["posted"] = {"at": now(), "text": a["text"], "ref": ref}
        msg = f"posted {f['id']} on {a['title'].split(' on ', 1)[-1]}"
    save(path, doc)
    print(msg)
    return doc


def main(argv=None):
    ap = argparse.ArgumentParser(prog="crow-review-run")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("repo"); s.add_argument("number", type=lambda v: int(v.lstrip("!#")))
    s.add_argument("--mode", choices=MODES, default="peer")
    s.add_argument("--branch", help="the MR's source branch: the run works in <repo>.wt/review-<number>")
    s.add_argument("--model", default=DEFAULT_MODEL)
    s.add_argument("--power", default="medium")
    s.add_argument("--force", action="store_true")
    for name in ("sync", "show", "apply", "actions"):
        x = sub.add_parser(name)
        x.add_argument("repo"); x.add_argument("number", type=lambda v: int(v.lstrip("!#")))
    sub.add_parser("check").add_argument("file")
    ac = sub.add_parser("act")
    ac.add_argument("repo"); ac.add_argument("number", type=lambda v: int(v.lstrip("!#")))
    ac.add_argument("id"); ac.add_argument("--hash", required=True)
    dc = sub.add_parser("decide")
    dc.add_argument("repo"); dc.add_argument("number", type=lambda v: int(v.lstrip("!#")))
    dc.add_argument("id"); dc.add_argument("state", choices=STATES)
    dc.add_argument("--note", default="")
    a = ap.parse_args(argv)
    if a.cmd == "start":
        start(a)
    elif a.cmd == "apply":
        apply(a.repo, a.number)
    elif a.cmd == "actions":
        doc = sync(a.repo, a.number)
        json.dump(actions(doc) if isinstance(doc, dict) else [], sys.stdout, indent=1, ensure_ascii=False); print()
    elif a.cmd == "act":
        act(a.repo, a.number, a.id, a.hash)
    elif a.cmd in ("sync", "show"):
        doc = sync(a.repo, a.number)
        if a.cmd == "show":
            json.dump(doc, sys.stdout, indent=1, ensure_ascii=False); print()
        else:
            print((doc or {}).get("run", {}).get("state", "none"))
    elif a.cmd == "decide":
        f = decide(a.repo, a.number, a.id, a.state, a.note)
        print(f"{f['id']} {f['state']}")
    elif a.cmd == "check":
        doc = load(a.file)
        errs = validate_file(doc) if doc is not None else ["file: missing or not JSON"]
        print("\n".join(errs) or "ok")
        sys.exit(1 if errs else 0)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""crow-focus: bring a Claude session to the front, or resume it when no window holds it.

  crow-focus --pid PID --account ACCOUNT --cwd DIR [--session ID] [--dry-run]
  crow-focus --pid PID --send TEXT [--dry-run]
  crow-focus --pid PID --interrupt [--dry-run]
  crow-focus --pid PID --stop [--dry-run]
  add --json to --send, --interrupt or --stop: one line {schema, ok, action, target, message, code}


Goes through the terminal backend (crow_term: CROW_TERMINAL=kitty|tmux|print).
Focus: finds the window (kitty) or pane (tmux) running PID, matching its own process or any
ancestor of PID (the shell the session was started from). Resume: when no window holds it (the
process is gone or runs elsewhere), opens a new window in DIR running `cdx ACCOUNT --dir DIR --resume`;
the print backend prints that command instead. --session resumes that session id (`--resume ID`);
with --pid 0 it never looks for a window (a History row).
--send types TEXT and Enter into the window holding PID (the deck's answer to an agent question) and
never resumes: it exits 1 when no window holds the session (always, on the print backend).
--interrupt presses Escape in the window holding PID (pauses the agent's turn; the session stays open).
--stop sends SIGTERM to PID, only when PID runs the claude CLI; the session can be resumed later.
--dry-run prints what it would do and does nothing.
--json (send, interrupt, stop): exit 0 done, 1 refused (no window, not a claude pid), 2 error (bad
arguments, the signal failed). Schema: logics/specs/script_contract/schemas/action.schema.json.
"""
import os, signal, subprocess, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402
import crow_term  # noqa: E402


def interrupt(pid, backend, dry):
    """(exit code, message): 0 done, 1 refused."""
    if dry:
        return 0, f"press Escape in the {backend} window holding pid {pid}"
    if crow_term.send_escape(pid, backend):
        return 0, "paused"
    return 1, f"no {backend} window holds pid {pid}"


def stop(pid, dry):
    """(exit code, message): 0 done, 1 refused, 2 error."""
    if not crow_term.is_claude(pid):
        return 1, f"pid {pid} is not a claude session, not stopping it"
    if dry:
        return 0, f"send SIGTERM to claude pid {pid}"
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as e:
        return 2, f"could not stop pid {pid} ({e})"
    return 0, "stopped"


def send(pid, text, backend, dry):
    """(exit code, message): 0 done, 1 refused."""
    if dry:
        return 0, f"type {text!r} and Enter into the {backend} window holding pid {pid}"
    if crow_term.send(pid, text, backend):
        return 0, "sent"
    return 1, (f"no {backend} window holds pid {pid}" if backend != "print"
               else "the print backend cannot type into a window (CROW_TERMINAL=kitty|tmux)")


def report(action, pid, code, message, as_json):
    if as_json:
        return crow_lib.action_result(code == 0, action, pid, message, code)
    print(message if code == 0 else f"crow-focus: {message}", file=sys.stdout if code == 0 else sys.stderr)
    return code


def main(argv):
    flags = {f for f in ("--dry-run", "--interrupt", "--stop", "--json") if f in argv}
    dry, as_json = "--dry-run" in flags, "--json" in flags
    opts, args = {}, [a for a in argv if a not in flags]
    for i in range(0, len(args) - 1, 2):
        opts[args[i].lstrip("-")] = args[i + 1]
    try:
        pid = int(opts.get("pid", 0))
        backend = crow_term.choose()
    except ValueError:
        if as_json:
            return crow_lib.action_result(False, "focus", opts.get("pid", ""), "bad --pid or terminal backend", 2)
        sys.exit(__doc__)
    action = "interrupt" if "--interrupt" in flags else "stop" if "--stop" in flags else "send" if "send" in opts else ""
    if action:
        if not pid:
            if as_json:
                return crow_lib.action_result(False, action, "", "--pid is required", 2)
            sys.exit(__doc__)
        if action == "interrupt":
            code, msg = interrupt(pid, backend, dry)
        elif action == "stop":
            code, msg = stop(pid, dry)
        else:
            code, msg = send(pid, opts["send"], backend, dry)
        return report(action, pid, code, msg, as_json)
    account, cwd = opts.get("account"), opts.get("cwd")
    if not account or not cwd:
        sys.exit(__doc__)
    resume = ["cdx", account, "--dir", cwd, "--resume"] + ([opts["session"]] if opts.get("session") else [])
    if dry:
        print(f"focus the {backend} window holding pid {pid}, else: {crow_term.print_line(resume, cwd)}")
        return 0
    if pid and (hit := crow_term.focus(pid, backend)):
        print(f"focused {hit}")
        return 0
    if not os.path.isdir(cwd):
        sys.exit(f"crow-focus: {cwd} is gone, cannot resume")
    try:
        out = crow_term.open_window(resume, f"crow · {os.path.basename(cwd)}", cwd, crow_term.clean_env(), backend=backend)
    except (OSError, subprocess.CalledProcessError) as e:
        sys.exit(f"crow-focus: could not open a {backend} window ({e})")
    print(f"resuming in a new {backend} window" if out == "opened" else f"run this in a new terminal to resume: {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

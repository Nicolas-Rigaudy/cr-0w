#!/usr/bin/env python3
"""crow-modules: which bricks are on (adr_002), and user bricks installed from git (item_265).

  crow-modules         one line per brick: on/off, default, summary; crow.yaml problems on stderr
  crow-modules json    {file, exists, modules: [{name, on, default, summary, requires, config}], errors}
  crow-modules link [<account>...]
                       generate the hub .claude/skills links (hub skills of on bricks, local/hub-skills)
                       and link profile skills of on bricks into each account (default: every allowed account)
  crow-modules which <cmd>
                       print the bin/ script of an on user brick named <cmd> or crow-<cmd>; exit 1 when none
  crow-modules add <git url> [--ref <tag|sha>] [--name <name>]
                       clone a user brick into the user modules dir, check its manifest, pin the commit
                       in modules.lock, turn it on in crow.yaml when it was off, link skills.
                       Default ref: the newest tag, else the default branch.
  crow-modules update [<name>] [--ref <tag|sha>]
                       move one (or every locked) brick to the newest tag or the given ref; rewrite the lock
  crow-modules remove <name>
                       delete the clone, its lock entry and its crow.yaml key; unlink its skills
  crow-modules on <brick> | off <brick>
                       switch a brick in crow.yaml (created when missing, other keys and config kept),
                       then rerun the link step. Refuses core, unknown bricks, an on brick whose
                       requires are off, and an off brick that an on brick requires.
  crow-modules require <field> <name>
                       exit 0 when the brick listing <name> under <field> (scripts, apps, skills...) is on;
                       else print "crow: module <brick> is off (crow.yaml)" and exit 2
  crow-modules get nest
                       {file, theme, hero, pages, known: {themes, heroes, pages}, errors} as JSON:
                       the Nest settings in crow.yaml and the names Nest can build from the on bricks
  crow-modules set nest <key> <value> [<key> <value>...] [--json]
                       write modules.nest.<key> (theme, hero, pages) in crow.yaml; pages is a comma list,
                       "" for every page. Every value is checked first: an unknown one exits 2 and
                       writes nothing. Only the modules.nest lines change. --json prints the get answer
                       plus changed (keys) and needs_build (hero or pages changed).

Bricks come from the engine manifests (modules/<brick>.yaml) and user bricks
(<CROW_HOME>/modules/<name>/module.yaml, or local/modules/ in a checkout; see docs/writing-a-brick.md). Switches and config come from
crow.yaml at the CROW_HOME root, else local/crow.yaml. A missing file or key keeps the default.
`crow doctor` fails on the errors listed here.
"""
import json
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402


def report(home=None, engine=None):
    st = crow_lib.load_modules(home, engine)
    man = crow_lib.all_manifests(home, engine)
    lock = crow_lib.read_modules_lock(home, engine)
    rows = [{"name": n, "on": m["on"], "default": m["default"], "summary": man[n].get("summary", ""),
             "requires": man[n].get("requires") or [], "config": m["config"], "source": m["source"],
             "dir": man[n].get("_dir", ""), "lock": lock.get(n),
             "deck_pages": (man[n].get("deck") or {}).get("pages") or [],
             "deck_boxes": (man[n].get("deck") or {}).get("boxes") or [],
             "nest_sections": [s.get("id") for s in (man[n].get("nest") or {}).get("sections") or [] if isinstance(s, dict)]}
            for n, m in sorted(st["modules"].items())]
    return {"file": st["file"], "exists": st["exists"], "modules": rows, "errors": st["errors"],
            "lock_problems": crow_lib.lock_problems(home, engine) if lock else []}


def accounts():
    """Allowed accounts whose Claude profile exists on disk."""
    import subprocess
    out = subprocess.run([os.path.join(crow_lib.ENGINE, "bin", "crow-accounts"), "allowed"],
                         capture_output=True, text=True).stdout
    return [n for n in out.split() if os.path.isdir(claude_dir(n))]


def claude_dir(account):
    return os.path.dirname(crow_lib.account_transcripts_dir(account))


def link(names):
    added, removed = crow_lib.link_hub_skills()
    print(f"hub: {len(added)} linked, {len(removed)} removed" + (f" ({', '.join(added + removed)})" if added or removed else ""))
    for n in names or accounts():
        added, removed = crow_lib.link_profile_skills(claude_dir(n))
        print(f"{n}: {len(added)} linked, {len(removed)} removed" + (f" ({', '.join(added + removed)})" if added or removed else ""))
    if not crow_lib.brick_on("design") and not names:
        # third-party design skills ship as a plugin (crow-skills-ext); off removes it where installed
        import subprocess
        subprocess.run([os.path.join(crow_lib.ENGINE, "bin", "crow-skills-ext"), "unlink"])
    return 0


def require(field, name):
    brick = crow_lib.brick_of(field, name)
    if crow_lib.brick_on(brick):
        return 0
    print(crow_lib.off_message(brick), file=sys.stderr)
    return 2


def main(argv):
    if argv[:1] == ["link"]:
        return link(argv[1:])
    if argv[:1] in (["add"], ["update"], ["remove"]):
        return {"add": add, "update": update, "remove": remove}[argv[0]](list(argv[1:]))
    if argv[:1] == ["which"] and len(argv) == 2:
        path = crow_lib.user_script(argv[1])
        if path:
            print(path)
        return 0 if path else 1
    if argv[:1] in (["on"], ["off"]) and len(argv) == 2:
        return switch(argv[1], argv[0] == "on")
    if argv[:1] == ["require"] and len(argv) == 3:
        return require(argv[1], argv[2])
    if argv == ["get", "nest"]:
        json.dump(nest_settings(), sys.stdout)
        print()
        return 0
    if argv[:1] == ["set"] and len(argv) >= 2:
        return set_settings(list(argv[1:]))
    if argv not in ([], ["json"]):
        sys.exit(__doc__)
    r = report()
    if argv:
        json.dump(r, sys.stdout)
        print()
        return 0
    print(f"crow.yaml: {r['file']}" + ("" if r["exists"] else " (none, defaults)"))
    for m in r["modules"]:
        flag = "on " if m["on"] else "off"
        note = "" if m["on"] == m["default"] else " (default " + ("on" if m["default"] else "off") + ")"
        pin = f" @ {m['lock']['ref']} {m['lock']['commit'][:7]}" if m.get("lock") else ""
        src = f" [user: {m['dir']}{pin}]" if m["source"] == "user" else ""
        print(f"{flag}  {m['name']:<18} {m['summary']}{note}{src}")
    for e in r["errors"]:
        print(f"crow-modules: {e['file']}: {e['key'] or '(file)'}: {e['error']}", file=sys.stderr)
    for p in r["lock_problems"]:
        print(f"crow-modules: modules.lock: {p}", file=sys.stderr)
    return 0


# --- user bricks from git (item_265) ---

def die(msg, code=1):
    print(f"crow-modules: {msg}", file=sys.stderr)
    sys.exit(code)


def git(cwd, *args, check=True):
    r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, check=False)
    if check and r.returncode:
        die(f"git {' '.join(args)}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip() if r.returncode == 0 else None


def newest_tag(folder):
    tags = (git(folder, "tag", "--sort=-v:refname", check=False) or "").split()
    return tags[0] if tags else None


def checkout(folder, ref):
    """Detach HEAD at ref (fetched first); return (ref shown in the lock, commit sha)."""
    git(folder, "fetch", "--quiet", "--tags", "--force", "origin", check=False)
    ref = ref or newest_tag(folder)
    if ref is None:  # no tag: the remote default branch
        git(folder, "checkout", "--quiet", "--detach", "origin/HEAD", check=False)
        return git(folder, "rev-parse", "--abbrev-ref", "origin/HEAD", check=False) or "HEAD", git(folder, "rev-parse", "HEAD")
    sha = git(folder, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", check=False) \
        or git(folder, "rev-parse", "--verify", "--quiet", f"origin/{ref}^{{commit}}", check=False)
    if not sha:
        die(f"ref {ref} not found in {folder}")
    git(folder, "checkout", "--quiet", "--detach", sha)
    return ref, sha


def manifest_errors(name):
    st = crow_lib.load_modules()
    return [e["error"] for e in st["errors"] if e["key"] == f"modules.{name}" and e["file"].endswith(crow_lib.USER_MANIFEST)]


def yaml_key_span(lines, name):
    """(start, end) line span of modules.<name> in crow.yaml text lines, else None. Block style only."""
    in_mods = False
    for i, line in enumerate(lines):
        if re.match(r"^modules:\s*(#.*)?$", line):
            in_mods = True
            continue
        if in_mods and line.strip() and not line[0].isspace():
            in_mods = False
        m = in_mods and re.match(r"^(\s+)" + re.escape(name) + r"\s*:", line)
        if m:
            indent, end = len(m.group(1)), i + 1
            while end < len(lines) and (not lines[end].strip() or len(lines[end]) - len(lines[end].lstrip()) > indent):
                end += 1
            return i, end, m.group(1)
    return None


def crow_yaml_set(name, value):
    """Set modules.<name> to `true` (value True) or drop it (value None), keeping the rest of the file."""
    path = crow_lib.crow_yaml_path()
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    span = yaml_key_span(lines, name)
    if value is None:
        if not span:
            return
        del lines[span[0]:span[1]]
    else:
        new = f"{span[2] if span else '  '}{name}: true"
        if span:
            lines[span[0]:span[1]] = [new]
        elif any(re.match(r"^modules:\s*(#.*)?$", line) for line in lines):
            at = next(i for i, line in enumerate(lines) if re.match(r"^modules:\s*(#.*)?$", line))
            lines.insert(at + 1, new)
        else:
            lines += ([] if lines else ["version: 1"]) + ["modules:", new]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def crow_yaml_switch(name, on):
    """Set modules.<name> on or off: the `on:` line of a mapping, else the scalar. Comments and config stay."""
    path = crow_lib.crow_yaml_path()
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    word = "true" if on else "false"
    span = yaml_key_span(lines, name)
    if span:
        start, end, indent = span
        sub = next((i for i in range(start + 1, end) if re.match(r"^\s+on\s*:", lines[i])), None)
        if sub is not None:
            lines[sub] = re.sub(r"^(\s+on\s*:\s*)[^#\s]*(\s*.*)$", lambda m: m.group(1) + word + m.group(2), lines[sub])
        elif end > start + 1 and any(lines[i].strip() and not lines[i].lstrip().startswith("#") for i in range(start + 1, end)):
            child = next(lines[i] for i in range(start + 1, end) if lines[i].strip())
            lines.insert(start + 1, f"{child[:len(child) - len(child.lstrip())]}on: {word}")
        else:
            lines[start] = re.sub(r"^(\s+" + re.escape(name) + r"\s*:\s*)[^#\s]*(\s*.*)$",
                                  lambda m: m.group(1) + word + m.group(2), lines[start])
    else:
        crow_yaml_set(name, True)
        if not on:
            return crow_yaml_switch(name, False)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def switch(name, on):
    man = crow_lib.all_manifests()
    if name not in man:
        die(f"unknown brick '{name}' (crow modules)")
    if name == "core":
        die("core is always on")
    st = crow_lib.load_modules()["modules"]
    if on:
        missing = [r for r in man[name].get("requires") or [] if not st.get(r, {}).get("on")]
        if missing:
            die(f"{name} requires {', '.join(missing)}: turn {'them' if len(missing) > 1 else 'it'} on first", 2)
    else:
        users = [n for n, m in sorted(man.items()) if st.get(n, {}).get("on") and name in (m.get("requires") or [])]
        if users:
            die(f"{', '.join(users)} require{'s' if len(users) == 1 else ''} {name}: turn {'them' if len(users) > 1 else 'it'} off first", 2)
    if st.get(name, {}).get("on") == on:
        print(f"{name} already {'on' if on else 'off'}")
        return 0
    crow_yaml_switch(name, on)
    if crow_lib.brick_on(name) != on:
        die(f"{crow_lib.crow_yaml_path()}: could not switch {name}; edit modules.{name} by hand")
    print(f"{name} {'on' if on else 'off'} ({crow_lib.crow_yaml_path()})")
    relink()
    return 0


# --- Nest settings (item_282) ---
# Engine names mirror ENGINE_THEMES/HEROES/PAGES in tools/nest/nest-modules.ts (a test keeps them equal).
NEST_THEMES = ["modern", "cyber"]
NEST_HEROES = ["holotable", "none"]
NEST_PAGES = ["home", "desk", "ops", "inbox", "mrs", "agenda", "reports"]
NEST_NAME = re.compile(r"^[a-z][a-z0-9-]*$")
NEST_KEYS = {"theme": "themes", "hero": "heroes", "pages": "pages"}
BUILD_KEYS = ("hero", "pages")  # compiled into Nest; the theme switches live


def _names(folder, ext):
    try:
        return sorted(n[:-len(ext)] for n in os.listdir(folder) if n.endswith(ext))
    except OSError:
        return []


def nest_known(rows):
    """Theme, hero and page names Nest can build from the on bricks, as nest-modules.ts collects them."""
    themes, heroes, pages = list(NEST_THEMES), list(NEST_HEROES), list(NEST_PAGES)
    for b in rows:
        if not b["on"] or not b["dir"]:
            continue
        root = os.path.join(b["dir"], "nest")
        for name in _names(os.path.join(root, "themes"), ".css"):
            if NEST_NAME.match(name) and name not in themes:
                with open(os.path.join(root, "themes", name + ".css")) as f:
                    if f"[data-theme='{name}']" in f.read():
                        themes.append(name)
        if any(os.path.isfile(os.path.join(root, "hero", n)) for n in ("index.tsx", "index.ts")):
            heroes.append(b["name"])
        pages += [n for n in _names(os.path.join(root, "pages"), ".tsx") if NEST_NAME.match(n) and n not in pages]
    return {"themes": themes, "heroes": heroes, "pages": pages}


def nest_settings():
    r = report()
    conf = next(m["config"] for m in r["modules"] if m["name"] == "nest")
    return {"file": r["file"], "theme": conf.get("theme"), "hero": conf.get("hero"), "pages": conf.get("pages"),
            "known": nest_known(r["modules"]),
            "errors": [e for e in r["errors"] if e["key"] == "modules.nest" or e["key"].startswith("modules.nest.")]}


def nest_values(pairs, known):
    """{key: value} from the key/value args, every value checked against the known names."""
    if not pairs or len(pairs) % 2:
        die("set nest wants <key> <value> pairs (keys: theme, hero, pages)", 2)
    out = {}
    for key, raw in zip(pairs[::2], pairs[1::2]):
        if key not in NEST_KEYS:
            die(f"unknown key {key!r} (keys: {', '.join(NEST_KEYS)})", 2)
        names = known[NEST_KEYS[key]]
        if key == "pages":
            val = []
            for p in (x.strip() for x in raw.split(",")):
                if p and p not in names:
                    die(f"unknown page {p!r} (known: {', '.join(names)})", 2)
                if p and p not in val:
                    val.append(p)
        elif raw not in names:
            die(f"unknown {key} {raw!r} (known: {', '.join(names)})", 2)
        else:
            val = raw
        out[key] = val
    return out


def yaml_value(v):
    """A plain YAML scalar or flow list, quoted when YAML would read it as something else."""
    import yaml
    if isinstance(v, list):
        return "[" + ", ".join(yaml_value(x) for x in v) + "]"
    return v if NEST_NAME.match(v) and yaml.safe_load(v) == v else json.dumps(v)


def read_text(path):
    """The file's text, "" when it does not exist."""
    if not os.path.exists(path):
        return ""
    with open(path) as f:
        return f.read()


def crow_yaml_config(name, values):
    """Set modules.<name>.<key> lines in crow.yaml, block style. The rest of the file and its comments stay."""
    path = crow_lib.crow_yaml_path()
    lines = read_text(path).splitlines()
    if not yaml_key_span(lines, name):
        crow_yaml_set(name, True)
        lines = read_text(path).splitlines()
        start, _, indent = yaml_key_span(lines, name)
        lines[start] = f"{indent}{name}:"  # a mapping without on: keeps the default switch
    start, end, indent = yaml_key_span(lines, name)
    head = re.match(r"^(\s+" + re.escape(name) + r"\s*:)[ \t]*([^#\s][^#]*?)?[ \t]*(#.*)?$", lines[start])
    if not head:
        die(f"{path}: cannot read modules.{name}; edit it by hand")
    if head.group(2):
        if head.group(2).startswith("{"):
            die(f"{path}: modules.{name} is a flow mapping; write it in block style to save settings", 1)
        # a scalar switch becomes the on: key of a mapping
        lines[start] = head.group(1) + (f"  {head.group(3)}" if head.group(3) else "")
        lines.insert(start + 1, f"{indent}  on: {head.group(2)}")
    for key, val in values.items():
        start, end, indent = yaml_key_span(lines, name)
        body = [i for i in range(start + 1, end) if lines[i].strip() and not lines[i].lstrip().startswith("#")]
        child = lines[body[0]][:len(lines[body[0]]) - len(lines[body[0]].lstrip())] if body else indent + "  "
        at = next((i for i in body if re.match(re.escape(child) + re.escape(key) + r"\s*:", lines[i])), None)
        if at is None:
            last = max([start, *body])
            lines.insert(last + 1, f"{child}{key}: {yaml_value(val)}")
            continue
        stop = at + 1  # a block list may follow the key, more indented or at the same indent with "- "
        for i in range(at + 1, end):
            ind = len(lines[i]) - len(lines[i].lstrip())
            if not lines[i].strip() or lines[i].lstrip().startswith("#"):
                continue
            if ind > len(child) or (ind == len(child) and lines[i].lstrip().startswith("- ")):
                stop = i + 1
            else:
                break
        note = re.search(r"\s(#.*)$", lines[at])
        lines[at:stop] = [f"{child}{key}: {yaml_value(val)}" + (f"  {note.group(1)}" if note else "")]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def set_settings(args):
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if args[0] != "nest":
        die(f"set {args[0]}: only nest settings can be set (crow modules set nest <key> <value>)", 2)
    before = nest_settings()
    values = nest_values(args[1:], before["known"])
    path = crow_lib.crow_yaml_path()
    saved = read_text(path) if os.path.exists(path) else None
    crow_yaml_config("nest", values)
    after = nest_settings()
    if any(after[k] != v for k, v in values.items()) or len(after["errors"]) > len(before["errors"]):
        if saved is None:
            os.remove(path)
        else:
            with open(path, "w") as f:
                f.write(saved)
        die(f"{path}: could not write modules.nest ({'; '.join(e['error'] for e in after['errors']) or 'value not read back'});"
            " file restored, edit it by hand")
    changed = [k for k in NEST_KEYS if k in values and before[k] != after[k]]
    needs_build = any(k in BUILD_KEYS for k in changed)
    if as_json:
        json.dump({**after, "changed": changed, "needs_build": needs_build}, sys.stdout)
        print()
        return 0
    for k in values:
        v = (", ".join(after[k]) or "(every page)") if k == "pages" else after[k]
        print(f"nest.{k}: {v}" + ("" if k in changed else " (unchanged)"))
    if needs_build:
        print("Nest builds hero and pages in: run crow nest build")
    return 0


def opt(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            die(f"{flag} needs a value")
        val = args[i + 1]
        del args[i:i + 2]
        return val
    return None


def relink():
    link([])
    if crow_lib.brick_on("nest"):
        print("Nest builds brick themes, heroes and pages in: run crow nest build")


def add(args):
    ref, name = opt(args, "--ref"), opt(args, "--name")
    if len(args) != 1:
        sys.exit(__doc__)
    url = args[0]
    name = name or re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1])
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name):
        die(f"brick name {name!r} must be lowercase letters, digits, - or _ (use --name)")
    if name in crow_lib.engine_manifests():
        die(f"user brick {name!r} clashes with the engine brick of the same name (use --name)", 2)
    root = crow_lib.user_modules_dir()
    folder = os.path.join(root, name)
    if os.path.exists(folder):
        die(f"{folder} already exists (crow modules update {name}, or remove it first)")
    os.makedirs(root, exist_ok=True)
    r = subprocess.run(["git", "clone", "--quiet", url, folder], capture_output=True, text=True, check=False)
    if r.returncode:
        die(f"git clone {url}: {r.stderr.strip()}")
    try:
        ref, sha = checkout(folder, ref)
        problems = manifest_errors(name)
        if problems:
            die(f"{name}: {'; '.join(problems)}", 2)
    except SystemExit:
        shutil.rmtree(folder, ignore_errors=True)
        raise
    lock = crow_lib.read_modules_lock()
    lock[name] = {"source": url, "ref": ref, "commit": sha}
    crow_lib.write_modules_lock(lock)
    if not crow_lib.load_modules()["modules"][name]["on"]:
        crow_yaml_set(name, True)
    print(f"{name}: added from {url} at {ref} ({sha[:12]})")
    off = crow_lib.load_modules()["modules"][name]
    if not off["on"]:
        print(f"{name}: stays off: {'; '.join(e['error'] for e in crow_lib.load_modules()['errors'] if e['key'] == f'modules.{name}')}", file=sys.stderr)
    relink()
    return 0


def update(args):
    ref = opt(args, "--ref")
    lock = crow_lib.read_modules_lock()
    names = args or sorted(lock)
    if ref and len(names) != 1:
        die("--ref needs one brick name")
    for name in names:
        if name not in lock:
            die(f"{name} is not in modules.lock (crow modules add <url>)")
        folder = os.path.join(crow_lib.user_modules_dir(), name)
        if git(folder, "status", "--porcelain", check=False):
            die(f"{name}: clone has local changes, not updated ({folder})")
        new_ref, sha = checkout(folder, ref)
        problems = manifest_errors(name)
        if problems:
            git(folder, "checkout", "--quiet", "--detach", lock[name]["commit"])
            die(f"{name}: {new_ref} refused, back at {lock[name]['ref']}: {'; '.join(problems)}", 2)
        old = lock[name]
        lock[name] = {**old, "ref": new_ref, "commit": sha}
        same = old.get("commit") == sha
        print(f"{name}: {'already at' if same else old.get('ref') + ' ->'} {new_ref} ({sha[:12]})")
    crow_lib.write_modules_lock(lock)
    relink()
    return 0


def remove(args):
    if len(args) != 1:
        sys.exit(__doc__)
    name = args[0]
    if name in crow_lib.engine_manifests():
        die(f"{name} is an engine brick; turn it off in crow.yaml instead", 2)
    folder = os.path.join(crow_lib.user_modules_dir(), name)
    lock = crow_lib.read_modules_lock()
    if not os.path.isdir(folder) and name not in lock:
        die(f"no user brick {name}")
    shutil.rmtree(folder, ignore_errors=True)
    lock.pop(name, None)
    crow_lib.write_modules_lock(lock)
    crow_yaml_set(name, None)
    print(f"{name}: removed")
    relink()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

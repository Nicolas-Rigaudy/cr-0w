#!/usr/bin/env python3
"""crow-doctor: is the hub set up right. Read only; it fixes nothing.

  crow-doctor           identity, accounts, stale worktrees, one line each
  crow-doctor --json    the same checks as JSON: {ok, checks: [{area, level, summary, details}]}

identity   git user.email of each registered repo against the registry identity of its scope
accounts   default account, accounts crow may target, cdx on PATH
quota      warn when every `use` account is blocked or past 90% of its 5h window (cdx status --cached)
worktrees  <repo>.wt/* trees already merged into the default branch (crow tidy --apply removes them)
profiles   each claude `use` account with permanent memory: memory links into local/memory, crow env and hooks,
           empty commit/PR attribution, crow skills/ linked (fix: crow-memory link <account>, copy settings from the default)

Exit 1 when a check fails, 0 otherwise (warnings do not fail).
"""
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HERE = os.path.dirname(os.path.realpath(__file__))


def load_registry():
    loader = importlib.machinery.SourceFileLoader("crow_registry", os.path.join(HERE, "crow-registry"))
    spec = importlib.util.spec_from_loader("crow_registry", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def accounts_json():
    r = subprocess.run([os.path.join(HERE, "crow-accounts"), "json"], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def check(area, level, summary, details=()):
    return {"area": area, "level": level, "summary": summary, "details": list(details)}


def quota(default):
    sys.path.insert(0, HERE)
    import crow_lib
    try:
        st = crow_lib.account_state(current=default, cached=True)
    except Exception as e:
        return check("quota", "ok", f"no quota data ({type(e).__name__})")
    uses = [a for a in st["accounts"] if a["policy"] == "use" and a["used_5h_pct"] is not None]
    details = [f"{a['name']}: 5h {a['used_5h_pct']}% week {a['used_week_pct']}% used"
               + (f", blocked: {a['blocked']}" if a["blocked"] else "") for a in st["accounts"]]
    if not uses:
        return check("quota", "ok", "no quota data for the use accounts", details)
    if all(a["blocked"] or a["used_5h_pct"] >= crow_lib.AUTO_FALLBACK_PCT for a in uses):
        alt = st["auto_target"] or st["recommended"]
        return check("quota", "warn", "every use account is out or past "
                     f"{crow_lib.AUTO_FALLBACK_PCT}%; " + (f"fallback {alt}" if alt else "no fallback free"), details)
    return check("quota", "ok", f"{len(uses)} use account(s) with room", details)


def identity(reg):
    ids, bad, checked = reg["identities"], [], 0
    for p in reg["projects"]:
        email, want = p["git"]["email"], ids.get(p["scope"], "")
        if not email or not want:
            continue
        checked += 1
        if email != want:
            bad.append(f"{p['name']} ({p['scope']}): {email}, registry says {want}")
    if not ids:
        return check("identity", "warn", "no identities in the registry")
    if bad:
        return check("identity", "fail", f"{len(bad)} of {checked} repos use another email", bad)
    return check("identity", "ok", f"{checked} repos match the registry")


def accounts(acc):
    if acc is None:
        return check("accounts", "fail", "crow-accounts did not answer")
    allowed = [a["name"] for a in acc["accounts"] if a["policy"] in ("use", "ask-first")]
    def line(a):
        prio = f", cdx priority {a['priority']}" if a.get('priority') else ""
        sc = ", scopes " + " ".join(f"{k}={v}" for k, v in sorted(a.get("scopes", {}).items(), key=lambda kv: kv[1])) \
            if a.get("scopes") else ""
        mr = ", min room " + " ".join(f"{k}={v}%" for k, v in a["scope_min_room"].items()) if a.get("scope_min_room") else ""
        return f"{a['name']}: {a['policy']}, memory {a['memory']}{prio}{sc}{mr}"
    details = [line(a) for a in acc["accounts"]]
    if not shutil.which("cdx"):
        return check("accounts", "fail", "cdx is not on PATH", details)
    default = next((a for a in acc["accounts"] if a["name"] == acc["default"]), None)
    if default is None:
        return check("accounts", "fail", f"default account '{acc['default']}' is not configured", details)
    if default["policy"] not in ("use", "ask-first"):
        return check("accounts", "fail", f"default account '{default['name']}' has policy {default['policy']}", details)
    return check("accounts", "ok", f"default {default['name']}, {len(allowed)} of {len(acc['accounts'])} allowed", details)


CROW_ENV = ("CROW_HOME", "CLAUDE_CODE_AUTO_COMPACT_WINDOW")
CROW_HOOKS = ("crow-ctx idle-hook", "rtk-rewrite")


def profile_gaps(account, home, profiles):
    """What a profile lacks to run crow like the default one, as short strings."""
    claude = Path(profiles) / account / "claude-home" / ".claude"
    if not claude.is_dir():
        return []
    gaps, store = [], (Path(home) / "local" / "memory").resolve()
    if store.is_dir():
        for slug in sorted(d.name for d in store.iterdir() if d.is_dir()):
            m = claude / "projects" / slug / "memory"
            if not (m.is_symlink() and m.resolve() == store / slug):
                gaps.append(f"memory not linked: {slug}")
    try:
        settings = json.loads((claude / "settings.json").read_text())
    except (OSError, ValueError):
        settings = {}
    env = settings.get("env") or {}
    gaps += [f"env {k} missing" for k in CROW_ENV if k not in env]
    hooks = json.dumps(settings.get("hooks") or {})
    gaps += [f"hook {h} missing" for h in CROW_HOOKS if h not in hooks]
    att = settings.get("attribution") or {}
    if att.get("commit") != "" or att.get("pr") != "":
        gaps.append("attribution commit/pr not empty")
    skills = Path(home) / "skills"
    for sk in sorted(d.name for d in skills.iterdir() if d.is_dir()) if skills.is_dir() else []:
        link = claude / "skills" / sk
        if not (link.is_symlink() and link.resolve() == (skills / sk).resolve()):
            gaps.append(f"skill {sk} not linked")
    return gaps


def provider(name):
    r = subprocess.run([os.path.join(HERE, "crow-accounts"), "provider", name], capture_output=True, text=True)
    return r.stdout.strip() or "claude"


def profiles(acc):
    if acc is None:
        return check("profiles", "ok", "no account data")
    sys.path.insert(0, HERE)
    import crow_lib
    home = crow_lib.data_home()
    root = crow_lib.profiles_dir()
    names = [a["name"] for a in acc["accounts"] if a["policy"] == "use" and a["memory"] == "permanent"
             and provider(a["name"]) == "claude"
             and (Path(root) / a["name"] / "claude-home" / ".claude").is_dir()]
    details = [f"{n}: {g}" for n in names for g in profile_gaps(n, home, root)]
    if details:
        return check("profiles", "warn", f"{len({d.split(':')[0] for d in details})} of {len(names)} "
                     "use profiles miss crow setup", details)
    return check("profiles", "ok", f"{len(names)} use profiles set up for crow")


def stale_worktrees(reg, mod):
    found = []
    for p in reg["projects"]:
        trees = Path(p["path"] + ".wt") if p["path"] else None
        if not trees or not trees.is_dir():
            continue
        base = mod.default_ref(p["path"])
        for tree in sorted(trees.glob("*")):
            head = mod.git(tree, "rev-parse", "HEAD")
            if head and subprocess.run(["git", "-C", p["path"], "merge-base", "--is-ancestor", head, base],
                                       capture_output=True).returncode == 0:
                found.append(f"{p['name']}: {tree.name}")
    if found:
        return check("worktrees", "warn", f"{len(found)} merged worktrees left behind", found)
    return check("worktrees", "ok", "no merged worktrees left behind")


def main(argv):
    if argv not in ([], ["--json"]):
        sys.exit(__doc__)
    mod = load_registry()
    reg = mod.load()
    acc = accounts_json()
    checks = [identity(reg), accounts(acc), quota((acc or {}).get("default")), profiles(acc),
              stale_worktrees(reg, mod)]
    ok = all(c["level"] != "fail" for c in checks)
    if argv:
        json.dump({"ok": ok, "checks": checks}, sys.stdout)
        print()
    else:
        mark = {"ok": "ok  ", "warn": "warn", "fail": "FAIL"}
        for c in checks:
            print(f"{mark[c['level']]}  {c['area']:<10} {c['summary']}")
            for d in c["details"] if c["level"] != "ok" or c["area"] == "accounts" else []:
                print(f"      {d}")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main(sys.argv[1:])

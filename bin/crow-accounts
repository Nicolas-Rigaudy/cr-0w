#!/usr/bin/env python3
"""crow-accounts: read the account policy from local/accounts.yaml.

  crow-accounts default            name of the default account
  crow-accounts policy <name>      use | ask-first | never (never when unknown)
  crow-accounts memory <name>      permanent | session | none
  crow-accounts allowed            names crow may target (policy use or ask-first)
  crow-accounts require <name>     exit 1 unless crow may target the account
  crow-accounts provider <name>    claude | codex (from cdx; claude when cdx does not say)
  crow-accounts permission <name>  cdx permission for hub one-shots: auto (claude), default (codex)
  crow-accounts hub-session <name> exit 1 when the account's provider cannot run a guarded hub session
  crow-accounts prompt <name> <skill> [args]   prompt that runs a hub skill on that provider
  crow-accounts check-model <name> <model>     exit 1 when the model belongs to the other provider
  crow-accounts pick [--on-busy ask|fail]   account for crow open/term/handoff: skips accounts with no quota
                                   left, ranks accounts with a live session after free ones, keeps the default while it has room,
                                   else the one with the most room; an ask-first pick asks on a terminal
                                   (fail: never ask); exits 1 with the reasons when none fits
  crow-accounts json               every account with its policy, memory mode and tier (mine | team),
                                   plus fallback/max_5h_pct/max_week_pct/free_5h_min when fallback is auto

The policy comes from cdx (`cdx set <name> --policy use|ask-first|never`) and falls back to the
policy in local/accounts.yaml for an account cdx has none for.
An unknown account, or a policy that is not one of use / ask-first / never, counts as never.
"""
import json, os, subprocess, sys
import yaml

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402

HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PATH = os.path.join(HOME, "local", "accounts.yaml")


def load():
    try:
        return yaml.safe_load(open(PATH)) or {}
    except FileNotFoundError:
        sys.exit(f"crow-accounts: {PATH} is missing (copy docs/accounts.example.yaml there)")


POLICIES = ("use", "ask-first", "never")


def cdx_policies():
    """Policy each account carries in cdx (`cdx set <name> --policy`); empty when cdx does not say."""
    try:
        r = subprocess.run(["cdx", "configs", "--json"], capture_output=True, text=True, timeout=20)
        return {s["name"]: s["policy"] for s in json.loads(r.stdout).get("sessions", []) if s.get("policy")}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def accounts(cfg):
    out = []
    cdx = cdx_policies()
    for a in cfg.get("accounts") or []:
        pol = cdx.get(a["name"]) or a.get("policy")
        row = {"name": a["name"], "policy": pol if pol in POLICIES else "never",
               "memory": a.get("memory", "none"), "tier": a.get("tier") if a.get("tier") == "team" else "mine"}
        if a.get("fallback") == "auto":  # shared account crow may pick alone, within its caps
            row.update(fallback="auto", **{k: a[k] for k in ("max_5h_pct", "max_week_pct", "free_5h_min") if k in a})
        out.append(row)
    return out


def find(cfg, name):
    return next((a for a in accounts(cfg) if a["name"] == name), None)


def status_rows():
    """cdx status rows by account name; empty when cdx does not answer."""
    try:
        r = subprocess.run(["cdx", "status", "--json"], capture_output=True, text=True, timeout=30)
        return {x["session_name"]: x for x in json.loads(r.stdout).get("rows") or [] if x.get("session_name")}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def ask(question):
    """y/N on the terminal; False without one."""
    try:
        with open("/dev/tty", "r+") as tty:
            tty.write(question + " [y/N] ")
            tty.flush()
            return tty.readline().strip().lower() in ("y", "yes")
    except OSError:
        return False


def pick(cfg, on_busy):
    from datetime import datetime
    default = cfg.get("default")
    st = crow_lib.pick_accounts(accounts(cfg), status_rows(), None, datetime.now().astimezone())
    p = crow_lib.launch_pick(st, crow_lib.live_sessions(), default)
    skipped = "; ".join(f"{s['name']}: {s['why']}" for s in p["skipped"])
    name = p["account"]
    if not name:
        sys.exit(f"crow: no allowed account is free with quota left ({skipped}). "
                 "Wait for a reset or pick one: CROW_ACCOUNT=<name> crow ...")
    if p["ask"] and not (on_busy == "ask" and ask(f"crow: use ask-first account '{name}' ({p['room']}% left; {skipped})?")):
        sys.exit(f"crow: only ask-first account '{name}' is free ({p['room']}% left; {skipped}). "
                 f"With the owner's OK: CROW_ACCOUNT={name} crow ...")
    if name != default or p["busy"]:
        also = "; already has a live session" if p["busy"] else ""
        print(f"crow: using '{name}' ({p['room']}% left{also}; {skipped})", file=sys.stderr)
    print(name)


def main(argv):
    cfg = load()
    cmd = argv[0] if argv else ""
    if cmd == "default":
        print(cfg["default"])
    elif cmd == "policy":
        a = find(cfg, argv[1])
        print(a["policy"] if a else "never")
    elif cmd == "memory":
        a = find(cfg, argv[1])
        print(a["memory"] if a else "none")
    elif cmd == "allowed":
        for a in accounts(cfg):
            if a["policy"] != "never":
                print(a["name"])
    elif cmd == "require" and len(argv) == 2:
        a = find(cfg, argv[1])
        if not a or a["policy"] == "never":
            sys.exit(f"crow: account '{argv[1]}' is not allowed (policy never, see local/accounts.yaml)")
    elif cmd == "provider" and len(argv) == 2:
        print(crow_lib.provider_of(argv[1]))
    elif cmd == "permission" and len(argv) == 2:
        print(crow_lib.permission(crow_lib.provider_of(argv[1])))
    elif cmd == "hub-session" and len(argv) == 2:
        why = crow_lib.hub_session_refusal(crow_lib.provider_of(argv[1]))
        if why:
            sys.exit(f"crow: account '{argv[1]}' cannot open a hub session: {why}")
    elif cmd == "prompt" and len(argv) >= 3:
        print(crow_lib.oneshot_prompt(crow_lib.provider_of(argv[1]), HOME, argv[2], " ".join(argv[3:])))
    elif cmd == "check-model" and len(argv) == 3:
        why = crow_lib.check_model(crow_lib.provider_of(argv[1]), argv[2])
        if why:
            sys.exit(f"crow: {why}")
    elif cmd == "pick" and argv[1:] in ([], ["--on-busy", "ask"], ["--on-busy", "fail"]):
        pick(cfg, argv[2] if len(argv) == 3 else "ask")
    elif cmd == "json":
        print(json.dumps({"default": cfg.get("default"), "accounts": accounts(cfg)}))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

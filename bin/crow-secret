#!/usr/bin/env python3
"""crow-secret: personal service tokens in the keyring (secret-tool, attributes service + user).

  crow secret set <service> [--user U] [--label L]   prompt for the value on the terminal and store it
  crow secret get <service> [--user U]               print the value (use inside $(...), never bare)
  crow secret list                                   keyring items and registry entries: labels, dates, expiry
  crow secret rm <service> [--user U]                delete the item

The user defaults to the service's entry in local/tokens.yaml, else to the only stored item.
set reads the value from the tty only, never from argv or a pipe. See runbooks/service-tokens.md.
"""
import argparse
import datetime as dt
import getpass
import os
import sys

import yaml

from crow_lib import secret_clear, secret_items, secret_lookup, secret_store

HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REGISTRY = os.path.join(HOME, "local", "tokens.yaml")
SOON = 30


def registry():
    try:
        with open(REGISTRY) as f:
            return (yaml.safe_load(f) or {}).get("tokens") or []
    except FileNotFoundError:
        return []


def die(msg, code=1):
    print(f"crow secret: {msg}", file=sys.stderr)
    sys.exit(code)


def resolve_user(service, user):
    if user:
        return user
    entry = next((t for t in registry() if t.get("service") == service), None)
    if entry and entry.get("user"):
        return entry["user"]
    users = sorted({i.get("user", "") for i in secret_items(service)} - {""})
    if len(users) == 1:
        return users[0]
    if not users:
        die(f"no user for '{service}': pass --user or add it to local/tokens.yaml")
    die(f"several users for '{service}' ({', '.join(users)}): pass --user")


def read_tty(service):
    try:
        os.close(os.open("/dev/tty", os.O_RDWR))
    except OSError:
        die("no terminal: run this in a real terminal (the ! shell and pipes cannot prompt)")
    value = getpass.getpass(f"{service} token (hidden): ")
    if not value.strip():
        die("empty value, nothing stored")
    return value.strip()


def cmd_set(a):
    user = resolve_user(a.service, a.user)
    value = read_tty(a.service)
    if not secret_store(a.service, user, value, a.label or f"crow {a.service} token"):
        die("secret-tool store failed (keyring locked or unreachable?)")
    if not any(t.get("service") == a.service for t in registry()):
        print(f"stored. Add '{a.service}' to local/tokens.yaml (scope, created, expiry, rotate).")
    else:
        print(f"stored {a.service} for {user}")


def cmd_get(a):
    user = resolve_user(a.service, a.user)
    value = secret_lookup(a.service, user)
    if not value:
        die(f"nothing stored for {a.service} / {user} (crow secret set {a.service})", 2)
    sys.stdout.write(value)


def cmd_rm(a):
    user = resolve_user(a.service, a.user)
    if not any(i.get("user") == user for i in secret_items(a.service)):
        die(f"nothing stored for {a.service} / {user}", 2)
    if not secret_clear(a.service, user):
        die("secret-tool clear failed")
    print(f"removed {a.service} for {user}")


def expiry_note(expiry, today):
    if not expiry:
        return ""
    try:
        days = (dt.date.fromisoformat(str(expiry)) - today).days
    except ValueError:
        return str(expiry)
    if days < 0:
        return f"{expiry} EXPIRED"
    return f"{expiry} ({days}d)" if days <= SOON else str(expiry)


def cmd_list(a):
    today = dt.date.today()
    reg = {(t.get("service"), t.get("user")): t for t in registry()}
    rows, seen = [], set()
    for i in secret_items():
        key = (i["service"], i.get("user") or i.get("username") or "")
        seen.add(key)
        t = reg.get(key, {})
        rows.append((key[0], key[1], i.get("label", ""), i.get("created", "")[:10],
                     i.get("modified", "")[:10], expiry_note(t.get("expiry"), today)))
    for key, t in reg.items():
        if key not in seen:
            rows.append((key[0], key[1] or "", "NOT STORED", "", "", expiry_note(t.get("expiry"), today)))
    head = ("SERVICE", "USER", "LABEL", "CREATED", "MODIFIED", "EXPIRES")
    widths = [max(len(str(r[c])) for r in rows + [head]) for c in range(len(head))]
    for r in [head] + sorted(rows):
        print("  ".join(str(v).ljust(w) for v, w in zip(r, widths)).rstrip())


def main():
    p = argparse.ArgumentParser(prog="crow secret", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("set", "get", "rm"):
        s = sub.add_parser(name)
        s.add_argument("service")
        s.add_argument("--user")
        if name == "set":
            s.add_argument("--label")
    sub.add_parser("list")
    a, extra = p.parse_known_args()
    if extra:  # never echo extra args: one could be a pasted token
        die(f"{len(extra)} unexpected argument(s); the value is never passed on the command line")
    {"set": cmd_set, "get": cmd_get, "rm": cmd_rm, "list": cmd_list}[a.cmd](a)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""crow-open: open URLs in the owner's real browser profile from a sandboxed session.

  crow-open URL [URL...]

Under cdx, HOME points at a sandbox, so xdg-open launches the browser with a throwaway
profile. This runs xdg-open with the real HOME/XDG dirs and no Claude/cdx variables.
Set BROWSER to this script so Claude Code's own opens (/login, artifacts) use it too.
"""
import os
import pwd
import subprocess
import sys

REAL_HOME = pwd.getpwuid(os.getuid()).pw_dir


def clean_env():
    """Detach from the calling session: real HOME, no inherited Claude/cdx variables."""
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("CLAUDE", "ANTHROPIC_", "CDX_")) and k != "BROWSER"}
    env.update(HOME=REAL_HOME,
               XDG_CONFIG_HOME=os.path.join(REAL_HOME, ".config"),
               XDG_DATA_HOME=os.path.join(REAL_HOME, ".local", "share"),
               XDG_CACHE_HOME=os.path.join(REAL_HOME, ".cache"))
    return env


def main(argv):
    if not argv:
        sys.exit(__doc__.strip())
    for url in argv:
        subprocess.Popen(["xdg-open", url], env=clean_env(), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main(sys.argv[1:])

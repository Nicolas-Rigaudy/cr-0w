#!/usr/bin/env python3
"""crow-runs: dispatch background runs and see what every agent is doing.

  crow-runs dispatch <project> <label> (--prompt-file F | --prompt T) [--kind task|review|retro] [--power P] [--model M]
                     [--permission review] [--dry-run]   every run carries crow_lib.run_flags (model id, effort, budget, timeout, env)
  crow-runs [list] [--since today|7d|DATE] [--all]   one-shot listing
  crow-runs json                                     same data as JSON (for widgets)
  crow-runs report <run_id>                          final report of a finished run
  crow-runs final <stdout_path> [provider]           final message of a run's stdout log (claude | codex)
  crow-runs wait <run_id>...                         block until the runs finish (run in background to get notified)
  crow-runs inbox [--hook] [--peek]                  finished runs not reported yet (the hook runs it on every prompt)
  crow-runs notify <run_id>...                       wait, then desktop-notify (dispatch starts it detached)
  (live view: tools/crow-watch, via `crow watch`)

Every dispatch is recorded in <state>/runs.jsonl (run id, project, label, start
commit). Running background runs come from `cdx runs --json`. Live agents come from the
claude and codex processes: their cwd, cdx account and (Claude) session transcript.
"""
import argparse, json, os, re, shutil, signal, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

import yaml

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402

HOME = Path(os.environ.get("CROW_HOME") or Path(__file__).resolve().parent.parent)
ACCOUNT = os.environ.get("CROW_ACCOUNT") or subprocess.check_output([os.path.join(os.path.dirname(os.path.realpath(__file__)), "crow-accounts"), "default"], text=True).strip()
REG = yaml.safe_load(open(HOME / "local/projects.yaml"))
STATE = Path(REG.get("vault", {}).get("crow_dir") or HOME / "local/state")
LEDGER = STATE / "runs.jsonl"
MAX_PARALLEL = int(os.environ.get("CROW_MAX_RUNS", "2"))
WORKING_S = 20      # transcript touched this recently = working
TAIL_BYTES = 2_000_000  # tool results are big; enough tail for ~30 recent actions
FINISHED_SHOWN = 5
RECENT_N = 30


def sh(*args, cwd=None):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def project(name):
    for p in REG["projects"]:
        if p["name"] == name:
            return p
    sys.exit(f"crow: unknown project '{name}' (see: crow ls)")


def project_name(cwd):
    best = None
    for p in REG["projects"]:
        if (cwd + "/").startswith(p["path"].rstrip("/") + "/") and (not best or len(p["path"]) > len(best["path"])):
            best = p
    if Path(cwd) == HOME:
        return "crow (hub)"
    return best["name"] if best else Path(cwd).name


def ledger():
    if not LEDGER.exists():
        return []
    return [json.loads(l) for l in LEDGER.read_text().splitlines() if l.strip()]


_finished_cache = {}


def finished_rows(since, ttl=8):
    """Every cdx run since `since` (running ones have no ended_at), keyed by run id."""
    hit = _finished_cache.get(since)
    if hit and time.time() - hit[0] < ttl:
        return hit[1]
    out = sh("cdx", "runs", "--since", since, "--limit", "200", "--json")
    runs = {r["run_id"]: r for r in (json.loads(out).get("runs", []) if out else [])}
    _finished_cache[since] = (time.time(), runs)
    return runs


def finished(since, ttl=8):
    return {k: r for k, r in finished_rows(since, ttl).items() if r.get("ended_at")}


def running_runs():
    """Background runs cdx still counts as running, any provider (`cdx runs --running`, cdx 0.23)."""
    out = sh("cdx", "runs", "--running", "--json")
    if not out:
        sys.exit("crow: `cdx runs --running --json` failed; cannot count running runs")
    return json.loads(out).get("runs", [])


def wait(run_ids, poll=20):
    """Block until every given run has finished; print one line per run as it ends.
    Run it as a background command so the caller is notified when it exits."""
    recs = {r["run_id"]: r for r in ledger()}
    pending = {next((k for k in recs if k.startswith(i)), i) for i in run_ids}
    while pending:
        done = finished("7d", ttl=0)
        for rid in sorted(pending):
            r = done.get(rid)
            if r:
                label = recs.get(rid, {}).get("label", "")
                status = "done" if r.get("exit_code") == 0 else "failed"
                print(f"{status} {rid[:8]} {recs.get(rid, {}).get('project', '')}  {label}", flush=True)
                pending.discard(rid)
        if pending:
            time.sleep(poll)


SEEN = STATE / "runs-seen.json"


def run_state(r):
    """done / budget / stuck / limit / failed for a finished cdx run row (budget: cdx stopped it at --budget;
    stuck: the watchdog killed it or it hit --timeout-seconds; limit: the stdout or stderr tail names a usage limit)."""
    if r.get("exit_code") == 0:
        return "done"
    if ((r.get("error") or {}).get("code") or "").startswith("budget_"):
        return "budget"
    if r.get("run_id") in stuck_ids() or r.get("status") == "timed_out":
        return "stuck"
    tail = ""
    for k in ("stdout_path", "stderr_path"):
        f = Path((r.get("artifacts") or {}).get(k) or "/nonexistent")
        tail += f.read_text(errors="replace")[-800:] if f.exists() else ""
    return "limit" if "limit" in tail.lower() else "failed"


STUCK = STATE / "runs-stuck.json"
STUCK_MIN = int(os.environ.get("CROW_STUCK_MIN", "20"))  # no transcript write for this long = stuck


def stuck_ids():
    try:
        return set(json.loads(STUCK.read_text()))
    except (OSError, ValueError):
        return set()


def run_transcript(row):
    """Claude session transcript of a running cdx run (None when not found yet, or Codex)."""
    sid = row.get("conversation_id") or row.get("provider_session_id")
    if not sid:
        return None
    return next((t for base in Path(crow_lib.profiles_dir()).glob("*/claude-home/.claude/projects")
                 for t in base.glob(f"*/{sid}.jsonl")), None)


def watchdog(row, now=None):
    """Kill a running run whose transcript has not moved for STUCK_MIN minutes. Returns True when killed."""
    now = now or time.time()
    t = run_transcript(row)
    started = iso_age(row["started_at"]) if row.get("started_at") else 0
    # A run waiting on subagents writes only to <sid>/subagents/*.jsonl.
    files = [t, *t.with_suffix("").glob("subagents/*.jsonl")] if t else []
    last = now - max(f.stat().st_mtime for f in files) if files else started
    if min(last, started) < STUCK_MIN * 60:
        return False
    sid = row.get("conversation_id") or ""
    pids = [x["pid"] for x in agent_procs() if sid and sid in " ".join(x["argv"])]
    for pid in pids + ([row["pid"]] if row.get("pid") else []):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    STUCK.parent.mkdir(parents=True, exist_ok=True)
    STUCK.write_text(json.dumps(sorted(stuck_ids() | {row["run_id"]})))
    return True


def seen_ids():
    try:
        return set(json.loads(SEEN.read_text()))
    except (OSError, ValueError):
        return set()


def mark_seen(*run_ids):
    ids = seen_ids() | set(run_ids)
    SEEN.parent.mkdir(parents=True, exist_ok=True)
    SEEN.write_text(json.dumps(sorted(ids)))


def inbox(hook=False, peek=False):
    """Finished runs dispatched by crow whose report nobody has read yet. Printed once, then marked seen."""
    recs = {r["run_id"]: r for r in ledger()}
    done = finished("7d", ttl=0)
    seen = seen_ids()
    fresh = [(done[k], recs[k]) for k in recs if k in done and k not in seen]
    if not fresh:
        return
    if hook:
        print("UNREPORTED BACKGROUND RUNS. Tell the owner now, before anything else: one line each (what finished, "
              "state), then read the report (`bin/crow-runs report <id>`) and summarise it. Put decisions in AskUserQuestion.")
    followups = {}
    for x in recs.values():
        for k in ("resumes", "continues"):
            if x.get(k):
                followups[x[k]] = x
    for r, rec in fresh:
        state = run_state(r)
        nxt = followups.get(r["run_id"])
        then = f"; resumed as {nxt['run_id'][:8]} on {nxt.get('account', ACCOUNT)}" if nxt else ""
        print(f"- {state} {r['run_id'][:8]} {rec.get('project', '')}  {rec.get('label', '')}  (ended {r['ended_at']}{then})")
    if not peek:
        mark_seen(*(r["run_id"] for r, _ in fresh))


def notify(run_ids, poll=20, max_hours=12):
    """Wait for the runs, then raise a desktop notification for each. Survives the session that started it.
    Gives up after `max_hours` so a lost run does not leave a poller behind."""
    recs = {r["run_id"]: r for r in ledger()}
    pending = {next((k for k in recs if k.startswith(i)), i) for i in run_ids}
    deadline = time.time() + max_hours * 3600
    while pending and time.time() < deadline:
        for row in running_runs():
            if row["run_id"] in pending and row.get("provider", "claude") == "claude" and row["run_id"] not in stuck_ids():
                watchdog(row)
        done = finished("7d", ttl=0)
        for rid in sorted(pending):
            if rid in done:
                rec = recs.get(rid, {})
                st = run_state(done[rid])
                msg = requeue(rec, deadline) if st == "limit" and rec else ""
                subprocess.run(["notify-send", "-a", "crow", "-u", "normal" if st == "done" else "critical",
                                f"Run {st}: {rec.get('project', '')}", " ".join(x for x in (rec.get("label", rid[:8]), msg) if x)])
                pending.discard(rid)
        if pending:
            time.sleep(poll)


MAX_CHAIN = 3          # limit requeues per original run
RESET_GRACE_S = 180    # wait this long past a window reset before continuing a run
RESUME_NOTE = ("RESUME NOTE: a usage limit cut the previous run of this task off. Partial work may already be "
               "in the tree: check `git log` and `git status` first, keep what is done, do not redo committed steps, "
               "and finish the remaining ones.\n\n")


def chain_depth(rec):
    recs = {r["run_id"]: r for r in ledger()}
    n = 0
    while rec and (rec.get("resumes") or rec.get("continues")) and n <= MAX_CHAIN:
        rec = recs.get(rec.get("resumes") or rec.get("continues"))
        n += 1
    return n


def requeue(rec, deadline):
    """A run stopped on a usage limit: move it to an account crow may use without asking (fresh run with a
    RESUME NOTE), else wait for its own window to reset and continue the conversation there.
    Returns a short note for the notification."""
    if chain_depth(rec) >= MAX_CHAIN:
        return f"not requeued: {MAX_CHAIN} limit requeues already"
    acct = rec.get("account") or ACCOUNT
    st = crow_lib.account_state(acct)
    base = [sys.executable, os.path.realpath(__file__), "dispatch", rec["project"], rec["label"],
            "--resumes", rec["run_id"]]
    if rec.get("cwd") and rec["cwd"] != project(rec["project"])["path"]:
        base += ["--cwd", rec["cwd"]]
    target = st["auto_target"] if st["current_blocked"] else None
    if target and rec.get("prompt_file") and Path(rec["prompt_file"]).exists():
        f = STATE / "dispatch" / f"resume-{rec['run_id'][:8]}.md"
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(RESUME_NOTE + Path(rec["prompt_file"]).read_text())
        cmd = base + ["--prompt-file", str(f), "--kind", rec.get("kind") or "task", "--account", target,
                      *(["--power", rec["power"]] if rec.get("power") else []),
                      *(["--model", rec["model"]] if rec.get("model") else []),
                      *(["--permission", rec["permission"]] if rec.get("permission") else [])]
        where = f"resumed on {target}"
    else:
        row = next((a for a in st["accounts"] if a["name"] == acct), {})
        if "weekly" in (st["current_blocked"] or ""):
            return "not requeued: weekly limit, no other account free without an OK"
        left = crow_lib.minutes_to(row.get("reset_5h_at_iso"), datetime.now().astimezone()) \
            if st["current_blocked"] else 0
        if left is None or time.time() + left * 60 + RESET_GRACE_S > deadline:
            return "not requeued: no account free and no reset in time (see `crow runs relaunch status`)"
        time.sleep(max(0, left * 60) + RESET_GRACE_S)
        cmd = base + ["--continue-run", rec["run_id"], "--account", acct, "--kind", rec.get("kind") or "task",
                      "--prompt", RESUME_NOTE + "Continue the task from where it stopped."]
        where = f"continued on {acct} after the reset"
    r = subprocess.run(cmd, capture_output=True, text=True)
    return where if r.returncode == 0 else f"requeue failed: {(r.stderr or r.stdout).strip()[:120]}"


def report(run_id, since="7d"):
    """Final report text of a finished run (the `result` of its stdout JSON)."""
    r = next((v for k, v in finished(since).items() if k.startswith(run_id)), None)
    if not r:
        return None
    f = Path(r.get("artifacts", {}).get("stdout_path") or "/nonexistent")
    if not f.exists():
        return None
    text = f.read_text(errors="replace")
    provider = r.get("provider") or "claude"
    rep = sh("cdx", "run-report", r["run_id"], "--json")
    final = (json.loads(rep).get("report", {}) if rep else {}).get("final_message")
    result = final or crow_lib.final_text(text, provider)
    mark_seen(r["run_id"])
    # A Claude run can end on a short postscript after its report: then take the last report-shaped message
    sid = next((o.get("session_id") for o in crow_lib._json_objects(text) if o.get("type") == "result"), None)
    if provider == "claude" and "Shipped" not in result and sid:
        full = report_from_transcript(sid)
        if full:
            return full
    return result


def report_from_transcript(session_id):
    pats = [Path.home() / ".claude/projects", *Path(crow_lib.profiles_dir()).glob("*/claude-home/.claude/projects")]
    for base in pats:
        for t in base.glob(f"*/{session_id}.jsonl"):
            texts = []
            for line in t.read_text(errors="replace").splitlines():
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("type") != "assistant":
                    continue
                for c in e.get("message", {}).get("content") or []:
                    if isinstance(c, dict) and c.get("type") == "text" and "Shipped" in c.get("text", ""):
                        texts.append(c["text"])
            if texts:
                return texts[-1]
    return None


def iso_age(iso):
    return time.time() - datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def fmt_age(s):
    s = int(s)
    if s < 60:
        return f"{s}s"
    return f"{s // 60}m" if s < 3600 else f"{s // 3600}h{(s % 3600) // 60:02d}"


# ---------- live agents (claude and codex processes) ----------

EXE = {"claude": re.compile(r"(^|/)claude$|/claude/versions/"), "codex": re.compile(r"(^|/)codex$")}


def provider_of(argv0, exe):
    return next((p for p, rx in EXE.items() if rx.search(argv0) or rx.search(exe)), None)


def agent_procs(proc="/proc"):
    """Live claude and codex processes (interactive sessions and headless runs)."""
    out = []
    for d in Path(proc).iterdir():
        if not d.name.isdigit():
            continue
        try:
            argv = [a.decode(errors="replace") for a in (d / "cmdline").read_bytes().split(b"\0") if a]
            try:
                exe = os.readlink(d / "exe")
            except OSError:
                exe = ""
            provider = provider_of(argv[0], exe) if argv else None
            if not provider:
                continue
            env = dict(l.split("=", 1) for l in (d / "environ").read_bytes().decode(errors="replace").split("\0") if "=" in l)
            out.append({
                "pid": int(d.name), "provider": provider, "argv": argv, "cwd": os.readlink(d / "cwd"),
                "home": env.get("HOME", ""), "account": env.get("CDX_SESSION_NAME"),
                "started": (d / "cmdline").stat().st_mtime,
            })
        except (OSError, ValueError):
            continue
    return out


def is_headless(argv):
    return "--print" in argv or "-p" in argv or "exec" in argv[1:2]


def arg(argv, flag):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else None


def transcript_path(home, cwd, sid):
    return Path(home) / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd) / f"{sid}.jsonl"


CD_PREFIX = re.compile(r"^(?:cd\s+(?:\"[^\"]*\"|'[^']*'|\S+)\s*(?:&&|;)\s*)+")
LONG_PATH = re.compile(r"(?<![\w.~-])/(?:[\w.@+-]+/)+([\w.@+-]+/?)")


def short_command(cmd):
    """A shell command without its leading `cd` and with absolute paths cut to their last part."""
    cmd = CD_PREFIX.sub("", " ".join(cmd.split()))
    return LONG_PATH.sub(lambda m: "…/" + m[1] if m[0].count("/") > 2 else m[0], cmd)


def summarize_tool(name, inp):
    """One line for a tool call: its own description (Bash, Agent) before the raw input."""
    for k in ("description", "command", "file_path", "pattern", "query", "url", "prompt", "skill"):
        if inp.get(k):
            v = str(inp[k]).strip().splitlines()[0]
            return f"{name}: {short_command(v) if k == 'command' else v}"
    return name


def read_transcript(path):
    """Last action, whether it ended on plain text (= waiting on the user), context size."""
    info = {"last_action": None, "ends_on_text": False, "context_tokens": None, "subagents_active": 0, "recent": [],
            "last_prompt": None}
    if not path.exists():
        return info
    size = path.stat().st_size
    with path.open("rb") as f:
        f.seek(max(0, size - TAIL_BYTES))
        lines = f.read().decode(errors="replace").splitlines()[1:] if size > TAIL_BYTES else f.read().decode(errors="replace").splitlines()
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "last-prompt" and info["last_prompt"] is None:
            info["last_prompt"] = (e.get("lastPrompt") or "").strip()[:400] or None
        msg = e.get("message") or {}
        if e.get("type") == "assistant" and isinstance(msg.get("content"), list) and len(info["recent"]) < RECENT_N:
            for c in reversed(msg["content"]):
                if c.get("type") == "tool_use":
                    info["recent"].append({"ts": e.get("timestamp"), "action": summarize_tool(c.get("name", "?"), c.get("input") or {})})
                elif c.get("type") == "text" and c.get("text", "").strip():
                    info["recent"].append({"ts": e.get("timestamp"), "action": "says: " + c["text"].strip().splitlines()[0]})
        if e.get("type") == "assistant" and isinstance(msg.get("content"), list):
            if info["context_tokens"] is None and msg.get("usage"):
                u = msg["usage"]
                info["context_tokens"] = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            if info["last_action"] is None:
                for c in reversed(msg["content"]):
                    if c.get("type") == "tool_use":
                        info["last_action"] = summarize_tool(c.get("name", "?"), c.get("input") or {})
                        break
                    if c.get("type") == "text" and c.get("text", "").strip():
                        info["last_action"] = "says: " + c["text"].strip().splitlines()[0]
                        info["ends_on_text"] = True
                        break
        elif e.get("type") == "user" and info["last_action"] is None and isinstance(msg.get("content"), str):
            info["last_action"] = "you: " + msg["content"].strip().splitlines()[0] if msg["content"].strip() else None
        if (info["last_action"] and info["context_tokens"] is not None and len(info["recent"]) >= RECENT_N
                and info["last_prompt"]):
            break
    info["recent"] = info["recent"][:RECENT_N][::-1]
    sub = path.with_suffix("") / "subagents"
    if sub.is_dir():
        info["subagents_active"] = sum(1 for s in sub.glob("*.jsonl") if time.time() - s.stat().st_mtime < 60)
    return info


def commits_since(cwd, sha, until=None):
    if not sha:
        return []
    extra = [f"--until={until}"] if until else []
    return sh("git", "log", "--oneline", *extra, f"{sha}..HEAD", cwd=cwd).splitlines()


def session_titles():
    """Titles crow-usage generated (Haiku) or mapped from dispatch labels, by session id."""
    try:
        return json.loads((HOME / "local/state/session-titles.json").read_text())
    except (OSError, ValueError):
        return {}


def project_usage():
    """Today's usage per project and the split of multi-project sessions (written by crow-usage)."""
    try:
        view = json.loads((STATE / "usage-projects.json").read_text())
    except (OSError, ValueError):
        return {"today": [], "sessions": {}}
    if view.get("date") != datetime.now().astimezone().date().isoformat():
        view["today"] = []
    return view


def collect(since="today", include_unledgered=False):
    now = time.time()
    done = finished(since)
    recs = ledger()
    cutoff = datetime.now().astimezone().date() if since == "today" else None
    agents, claimed = [], set()
    titles = session_titles()

    for p in agent_procs():
        # Claude keeps <home>/.claude/sessions/<pid>.json current (session id changes on /clear).
        meta = {}
        try:
            meta = json.loads((Path(p["home"]) / ".claude/sessions" / f"{p['pid']}.json").read_text())
        except (OSError, ValueError):
            pass
        sid = meta.get("sessionId") or arg(p["argv"], "--session-id") or arg(p["argv"], "--resume")
        if not sid and p["provider"] == "claude":
            continue  # short-lived helper process, not an agent
        kind = "run" if is_headless(p["argv"]) else "session"
        account = p["account"] or (re.search(r"/profiles/([^/]+)/", p["home"]) or [None, "default"])[1]
        tpath = transcript_path(p["home"], p["cwd"], sid) if sid and p["provider"] == "claude" else None
        mtime = tpath.stat().st_mtime if tpath and tpath.exists() else p["started"]
        t = read_transcript(tpath) if tpath else {}
        idle = now - mtime
        if meta.get("status") == "busy" or idle < WORKING_S:
            state = "working"
        elif kind == "session" and t.get("ends_on_text"):
            state = "waiting"
        else:
            state = "idle" if kind == "session" else "quiet"
        a = {
            "kind": kind, "provider": p["provider"], "pid": p["pid"], "account": account, "project": project_name(p["cwd"]),
            "cwd": p["cwd"], "session_id": sid, "state": state,
            "started_at": datetime.fromtimestamp(p["started"], timezone.utc).isoformat(timespec="seconds"),
            "last_activity_s": int(idle), **{k: t.get(k) for k in ("last_action", "context_tokens", "subagents_active", "recent", "last_prompt")},
            "run_id": None, "label": None, "title": (titles.get(sid) or {}).get("title"), "commits": [],
        }
        if kind == "run":
            for rec in reversed(recs):
                if rec["cwd"] == p["cwd"] and rec["run_id"] not in done and rec["run_id"] not in claimed:
                    claimed.add(rec["run_id"])
                    a.update(run_id=rec["run_id"], label=rec["label"], commits=commits_since(rec["cwd"], rec.get("start_sha")))
                    break
        agents.append(a)

    superseded = {}
    for i, rec in enumerate(recs):
        if rec.get("resumes"):
            superseded[rec["resumes"]] = rec["run_id"]
        for later in recs[i + 1:]:
            if later["project"] == rec["project"] and later["label"].startswith(rec["label"]):
                superseded.setdefault(rec["run_id"], later["run_id"])
                break
    past = []
    for rec in reversed(recs):
        if rec["run_id"] in claimed or (rec["run_id"] in superseded and not include_unledgered):
            continue
        if cutoff and datetime.fromisoformat(rec["started_at"]).astimezone().date() < cutoff:
            continue
        r = done.get(rec["run_id"])
        if r:
            st = run_state(r)
        else:
            st = "lost"
        past.append({
            "run_id": rec["run_id"], "project": rec["project"], "label": rec["label"], "status": st,
            "duration_s": int(r["duration_seconds"]) if r and r.get("duration_seconds") else None,
            "ended_at": r.get("ended_at") if r else None,
            "resumed_from": [k for k, v in superseded.items() if v == rec["run_id"]],
            "commits": commits_since(rec["cwd"], rec.get("start_sha"), r.get("ended_at") if r else None),
        })
    if include_unledgered:
        known = {rec["run_id"] for rec in recs}
        for rid, r in done.items():
            if rid not in known:
                past.append({"run_id": rid, "project": project_name(r["cwd"]), "label": "(not dispatched by crow)",
                             "status": "done" if r.get("exit_code") == 0 else "failed",
                             "duration_s": int(r.get("duration_seconds") or 0), "ended_at": r.get("ended_at"), "commits": []})

    busy = len(running_runs())
    pu = project_usage()
    for a in agents:
        split = pu["sessions"].get(a["session_id"])
        a["multi_project"] = bool(split)
        a["projects"] = split["projects"] if split else []
    return {"usage_by_project": pu["today"], "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "slots": {"busy": busy, "max": MAX_PARALLEL}, "agents": agents, "finished": past}


# ---------- commands ----------

def pick_account(a):
    """--account wins (the caller has the owner's OK). --continue-run stays on the parent run's account
    (cdx cannot move a conversation). Otherwise the default account, or the account crow may use
    without asking when the default is blocked or nearly out."""
    if a.account:
        return a.account
    if a.continue_run:
        parent = next((r for r in ledger() if r["run_id"].startswith(a.continue_run)), {})
        return parent.get("account") or ACCOUNT
    try:
        st = crow_lib.account_state(ACCOUNT)
    except Exception:  # no usable account data: dispatch as before, cdx still refuses a blocked account
        return ACCOUNT
    if not st["current_blocked"]:
        return ACCOUNT
    if st["auto_target"]:
        print(f"crow: {ACCOUNT} is out ({st['current_blocked']}); dispatching on {st['auto_target']}", file=sys.stderr)
        return st["auto_target"]
    rec = st["recommended"]
    sys.exit(f"crow: {ACCOUNT} is out ({st['current_blocked']}). " +
             (f"{rec} is free but needs the owner's OK: rerun with --account {rec} once given."
              if rec else "No allowed account is free; wait for the reset."))


def dispatch(a):
    acct = pick_account(a)
    if subprocess.run([str(HOME / "bin/crow-accounts"), "require", acct]).returncode:
        sys.exit(1)
    p = project(a.project)
    cwd = p["path"]
    if a.cwd:  # a worktree of the project (<path>.wt/...), never another folder
        cwd = os.path.realpath(a.cwd)
        if not cwd.startswith(os.path.realpath(p["path"]) + ".wt/") or not os.path.isdir(cwd):
            sys.exit(f"crow: --cwd must be an existing worktree under {p['path']}.wt/")
    runs = running_runs()
    # A review run cannot write, so it may share the folder with another run.
    if any(x["cwd"] == cwd for x in runs) and not a.force and a.permission != "review":
        sys.exit(f"crow: a run is already working in {cwd}; --force to override")
    provider = crow_lib.provider_of(acct)
    src = ["--prompt-file", a.prompt_file] if a.prompt_file else ["--prompt", a.prompt]
    if provider == "codex":  # Codex does not load CLAUDE.md: start the prompt with the read-first list
        task = Path(a.prompt_file).read_text() if a.prompt_file else a.prompt
        pre = Path(STATE / "dispatch")
        pre.mkdir(parents=True, exist_ok=True)
        f = pre / f"{a.project}-{a.label}.md".replace("/", "_")
        f.write_text("Read these files first: " + ", ".join(crow_lib.read_first(str(HOME), cwd)) + ".\n\n" + task)
        src = ["--prompt-file", str(f)]
    # --continue-run pins the parent's model and effort: cdx refuses any other value.
    flags, env = crow_lib.run_flags(a.kind, provider, a.model, a.power, a.continue_run)
    cmd = ["cdx", "run", acct, "--cwd", cwd, *src, *(["--continue-run", a.continue_run] if a.continue_run else []), *flags,
           "--permission", a.permission or crow_lib.permission(provider), "--detach", "--json",
           "--label", f"{p['name']}/{a.label}", *([] if a.force else ["--max-parallel", str(MAX_PARALLEL)])]
    if a.dry_run:
        print(" ".join(f"{k}={v}" for k, v in env.items()), " ".join(cmd))
        return
    out = subprocess.run(cmd, capture_output=True, text=True, env=crow_lib.run_env(env)).stdout.strip()
    try:
        res = json.loads(out)
    except ValueError:
        res = {"ok": False}
    if not res.get("ok"):
        if "too_many_runs" in out:
            sys.exit(f"crow: {MAX_PARALLEL} runs already running; --force to override")
        err = res.get("error")
        sys.exit(f"crow: dispatch failed: {err.get('code', '') + ': ' if isinstance(err, dict) and err.get('code') else ''}"
                 f"{err.get('message') if isinstance(err, dict) else err}")
    rec = {
        "run_id": res["run_id"], "project": p["name"], "label": a.label, "cwd": cwd,
        "started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "start_sha": sh("git", "rev-parse", "HEAD", cwd=cwd),
        "branch": sh("git", "branch", "--show-current", cwd=cwd),
        "account": acct, "prompt_file": a.prompt_file, "power": a.power, "model": a.model, "permission": a.permission or "",
        "kind": a.kind,
    }
    if a.continue_run:
        rec["continues"] = a.continue_run
    if a.resumes:
        rec["resumes"] = next((r["run_id"] for r in ledger() if r["run_id"].startswith(a.resumes)), a.resumes)
    STATE.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a") as f:
        f.write(json.dumps(rec) + "\n")
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "notify", rec["run_id"]],
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"dispatched {rec['run_id'][:8]}  {p['name']}  {a.label}" + ("" if acct == ACCOUNT else f"  on {acct}"))
    print(f"NEXT: start `bin/crow-runs wait {rec['run_id'][:8]}` as a background Bash command now (wakes this session when the run ends)")


C = {"dim": "\033[2m", "b": "\033[1m", "g": "\033[32m", "y": "\033[33m", "r": "\033[31m", "c": "\033[36m", "m": "\033[35m", "0": "\033[0m"}
STATE_STYLE = {"working": ("●", "g"), "quiet": ("◌", "y"), "waiting": ("◆", "m"), "idle": ("○", "dim")}
PAST_STYLE = {"done": ("✓", "g"), "failed": ("✗", "r"), "limit": ("⏸", "y"), "lost": ("?", "dim"),
              "budget": ("$", "y"), "stuck": ("!", "r")}


def render(data, color=True, width=None):
    width = width or shutil.get_terminal_size((120, 40)).columns
    c = C if color else {k: "" for k in C}

    def clip(s, indent=0):
        s = s.replace("\n", " ")
        return s if len(s) + indent <= width else s[: max(0, width - indent - 1)] + "…"

    out = []
    runs = [a for a in data["agents"] if a["kind"] == "run"]
    sess = [a for a in data["agents"] if a["kind"] == "session"]
    sl = data["slots"]
    out.append(f"{c['b']}CR-0W agents{c['0']}  {c['dim']}{datetime.now():%H:%M:%S}{c['0']}   "
               f"background slots {sl['busy']}/{sl['max']}   sessions {len(sess)}")

    def agent_lines(a, title):
        sym, col = STATE_STYLE[a["state"]]
        ctx = f" · context {a['context_tokens'] // 1000}k tokens" if a.get("context_tokens") else ""
        subs = f" · {a['subagents_active']} subagents" if a.get("subagents_active") else ""
        meta = f"{a['state']} {fmt_age(a['last_activity_s'])} ago · up {fmt_age(iso_age(a['started_at']))}{ctx}{subs} · {a['account']}"
        out.append(clip(f"{c[col]}{sym}{c['0']} {c['b']}{a['project']:<20}{c['0']} {title}") )
        out.append(clip(f"    {c['dim']}{meta}{c['0']}", 0))
        if a.get("last_action"):
            out.append(clip(f"    {c['c']}↳ {a['last_action']}{c['0']}", 0))
        for cm in a.get("commits", [])[:3]:
            out.append(clip(f"    {c['dim']}{cm}{c['0']}", 0))
        if len(a.get("commits", [])) > 3:
            out.append(f"    {c['dim']}… {len(a['commits']) - 3} more commits{c['0']}")

    out.append("")
    out.append(f"{c['b']}Background runs{c['0']}")
    if not runs:
        out.append(f"  {c['dim']}none{c['0']}")
    for a in runs:
        agent_lines(a, (a["label"] or "(not dispatched by crow)") + (f" {c['dim']}{a['run_id'][:8]}{c['0']}" if a["run_id"] else ""))

    out.append("")
    out.append(f"{c['b']}Interactive sessions{c['0']}")
    if not sess:
        out.append(f"  {c['dim']}none{c['0']}")
    for a in sorted(sess, key=lambda a: a["last_activity_s"]):
        agent_lines(a, f"{c['dim']}{(a['session_id'] or '')[:8]}{c['0']}")

    if data["finished"]:
        out.append("")
        out.append(f"{c['b']}Finished today{c['0']}")
        for f in data["finished"][:FINISHED_SHOWN]:
            sym, col = PAST_STYLE[f["status"]]
            d = fmt_age(f["duration_s"]) if f.get("duration_s") else "?"
            ended = f" · ended {fmt_age(iso_age(f['ended_at']))} ago" if f.get("ended_at") else ""
            resumed = f" · resumed {len(f['resumed_from'])}×" if f.get("resumed_from") else ""
            out.append(clip(f"{c[col]}{sym}{c['0']} {f['project']:<20} {f['label']}"))
            out.append(clip(f"    {c['dim']}{f['status']} after {d}{ended} · {len(f['commits'])} commits{resumed} · {f['run_id'][:8]}{c['0']}"))
        if len(data["finished"]) > FINISHED_SHOWN:
            out.append(f"  {c['dim']}… {len(data['finished']) - FINISHED_SHOWN} older (crow runs --all){c['0']}")
    return out


def listing(a):
    print("\n".join(render(collect(a.since, a.all), color=sys.stdout.isatty())))


def main():
    ap = argparse.ArgumentParser(prog="crow runs")
    sub = ap.add_subparsers(dest="cmd")
    d = sub.add_parser("dispatch")
    d.add_argument("project"); d.add_argument("label")
    g = d.add_mutually_exclusive_group(required=True)
    g.add_argument("--prompt-file"); g.add_argument("--prompt")
    d.add_argument("--power", help="effort; default from the run kind (crow_lib.RUN_KINDS)")
    d.add_argument("--model", help="model for this run (opus, sonnet); default from the run kind, pinned to its exact id")
    d.add_argument("--kind", choices=tuple(crow_lib.RUN_KINDS), default="task", help="budget, timeout and defaults (crow_lib.RUN_KINDS)")
    d.add_argument("--dry-run", action="store_true", help="print the cdx command and env, start nothing")
    d.add_argument("--permission", choices=("review",), help="review: read only (Claude plan mode, Codex read-only sandbox)")
    d.add_argument("--force", action="store_true")
    d.add_argument("--resumes", metavar="RUN_ID", help="this run continues an interrupted one (hides it from the listing)")
    d.add_argument("--cwd", help="run in this worktree of the project (<path>.wt/...) instead of the main checkout")
    d.add_argument("--account", help="run on this account (an ask-first account needs the owner's OK first)")
    d.add_argument("--continue-run", metavar="RUN_ID", help="resume that finished run's conversation (cdx --continue-run; its model and effort)")
    sub.add_parser("report").add_argument("run_id")
    fp = sub.add_parser("final")
    fp.add_argument("stdout_path")
    fp.add_argument("provider", nargs="?", default="claude")
    sub.add_parser("wait").add_argument("run_ids", nargs="+")
    sub.add_parser("notify").add_argument("run_ids", nargs="+")
    ib = sub.add_parser("inbox")
    ib.add_argument("--hook", action="store_true"); ib.add_argument("--peek", action="store_true")
    for name in ("list", "json"):
        p = sub.add_parser(name)
        p.add_argument("--since", default="today")
        p.add_argument("--all", action="store_true", help="include runs not dispatched by crow")
    ap.set_defaults(since="today", all=False)
    a = ap.parse_args()
    if a.cmd == "dispatch":
        dispatch(a)
    elif a.cmd == "wait":
        wait(a.run_ids)
    elif a.cmd == "notify":
        notify(a.run_ids)
    elif a.cmd == "inbox":
        inbox(a.hook, a.peek)
    elif a.cmd == "final":
        print(crow_lib.final_text(Path(a.stdout_path).read_text(errors="replace"), a.provider))
    elif a.cmd == "report":
        print(report(a.run_id) or "")
    elif a.cmd == "json":
        json.dump(collect(a.since, a.all), sys.stdout, indent=1); print()
    else:
        listing(a)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""crow-contract: validate run output files against the run contract.

  crow-contract FILE...   plan/report/mockup .md (one ```crow block) or outbox/questions.json
Prints "ok FILE" or "FILE: error" lines. Exit 1 if any file is invalid.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from crow_contract import parse_file


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    bad = 0
    for f in argv:
        res = parse_file(f)
        if res.ok:
            print(f"ok {f}")
        else:
            bad += 1
            for e in res.errors:
                print(f"{f}: {e}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""crow-registry: the project registry (local/projects.yaml) plus cheap git state, as JSON for the deck.

  crow-registry json   {identities, state_dir, projects: [{name, short, scope, forge, remote, path, release, status,
                        logics, git: {email, dirty, ahead, stale_trees}}]}

state_dir is vault.crow_dir, else local/state. short is the first alias, else the name. stale_trees counts <path>.wt/* worktrees already merged into
the default branch. Read only.
"""
import json, os, subprocess, sys
from pathlib import Path

import yaml

HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def git(path, *args):
    r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True, timeout=15)
    return r.stdout.strip() if r.returncode == 0 else None


def default_ref(path):
    ref = git(path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if ref:
        return ref
    return next((b for b in ("main", "master") if git(path, "rev-parse", "--verify", "-q", b)), "HEAD")


def stale_trees(path):
    trees = Path(str(path) + ".wt")
    if not trees.is_dir():
        return 0
    base, n = default_ref(path), 0
    for tree in sorted(trees.glob("*")):
        head = git(tree, "rev-parse", "HEAD")
        if head and subprocess.run(["git", "-C", str(path), "merge-base", "--is-ancestor", head, base],
                                   capture_output=True).returncode == 0:
            n += 1
    return n


def git_state(path):
    if not path or not (Path(path) / ".git").exists():
        return {"email": "", "dirty": 0, "ahead": 0, "stale_trees": 0}
    status = git(path, "status", "--porcelain") or ""
    ahead = git(path, "rev-list", "--count", "@{u}..HEAD")
    return {"email": git(path, "config", "user.email") or "", "dirty": len([l for l in status.splitlines() if l]),
            "ahead": int(ahead) if ahead and ahead.isdigit() else 0, "stale_trees": stale_trees(path)}


def load():
    try:
        reg = yaml.safe_load(open(os.path.join(HOME, "local", "projects.yaml"))) or {}
    except FileNotFoundError:
        reg = {}
    out = []
    for p in reg.get("projects") or []:
        aliases = p.get("aliases") or []
        out.append({
            "name": p["name"], "short": aliases[0] if aliases else p["name"],
            "scope": p.get("scope", ""), "forge": p.get("forge", "none"), "remote": p.get("remote", ""),
            "path": p.get("path", ""), "release": p.get("release") or {}, "status": p.get("status", ""),
            "logics": bool(p.get("logics")), "git": git_state(p.get("path", "")),
        })
    state = (reg.get("vault") or {}).get("crow_dir") or os.path.join(HOME, "local", "state")
    return {"identities": reg.get("identities") or {}, "state_dir": state, "projects": out}


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] != "json":
        sys.exit(__doc__)
    json.dump(load(), sys.stdout)

#!/usr/bin/env python3
"""crow-relaunch: continue a session on another allowed cdx account, always by conversation id.

  crow-relaunch <conversation-id> <target> [--dry-run] [--yes] [--picked] [--here]
  crow-relaunch status [--json]     allowed accounts, which are blocked, the recommended target
  crow-relaunch rescue <account> [--to T] [--dry-run]
                                    every session the account lost in its last 5h window
                                    (cut off by the limit, or still open on it), relaunched on one OK
  crow-relaunch hook                UserPromptSubmit: warn once at 80% and 95% of the current
                                    account's 5h or week window, with the reset and the fallback

The id may be a unique prefix of a session in the interrupted registry (crow-sessions), or a
full id of any top-level transcript. The relaunch refuses when:
  - no id is given, or it does not resolve to exactly one transcript;
  - the target (or the profile holding the source) has policy never, or the target is the source;
  - none of the workspaces the transcript worked in still exists;
  - `cdx can-resume <target>` says no, or `cdx status` shows the target blocked.
Then it asks: a `use` account takes y (or --yes); an `ask-first` account needs a typed "yes"
on a terminal every time, --yes does not count. --picked is that yes from an interactive picker
(crow-deck's Relaunch table): the owner chose this account for this session, so it counts for
both policies. --dry-run runs only the read-only checks
(can-resume, status) and prints the handoff it would run; nothing is launched or prepared.

The handoff is `cdx handoff <source> <target> --source-conversation <id>`, run from the
session's workspace in a new terminal window (crow_term backend: kitty, tmux, or the command
printed to run by hand; detached, real HOME, no inherited Claude/cdx variables); --here runs it
in the current terminal instead. Accounts with memory mode session get local/memory linked for the run.
"""
import json, os, re, subprocess, sys
from datetime import datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import crow_lib  # noqa: E402
import crow_term  # noqa: E402

HOME = os.environ.get("CROW_HOME") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BIN = os.path.join(HOME, "bin")
PROFILES = crow_lib.profiles_dir()
ID_RE = re.compile(r"[A-Za-z0-9_-]+")


def die(msg):
    sys.exit(f"crow-relaunch: {msg}")


def helper(*args):
    r = subprocess.run([os.path.join(BIN, args[0]), *args[1:]], capture_output=True, text=True)
    if r.returncode:
        die((r.stderr or r.stdout).strip() or f"{args[0]} failed")
    return r.stdout


def cdx_json(*args):
    try:
        r = subprocess.run(["cdx", *args, "--json"], capture_output=True, text=True, timeout=60)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        die(f"cdx {' '.join(args)}: {e}")
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        die(f"cdx {' '.join(args)} gave no JSON: {(r.stderr or r.stdout).strip()[:200]}")


def accounts():
    return {a["name"]: a for a in json.loads(helper("crow-accounts", "json"))["accounts"]}


# ---------- block detection ----------

def limits():
    rows = cdx_json("status").get("rows") or []
    return {r["session_name"]: r for r in rows if r.get("session_name")}


def blocked_reason(row):
    return crow_lib.hard_block(row)


def account_status(current, scope=None):
    return crow_lib.pick_accounts(list(accounts().values()), limits(), current, datetime.now().astimezone(), scope)


def scope_of(items):
    """Registry scope shared by the sessions' folders (a worktree counts for its repo); None when mixed or unknown."""
    try:
        import yaml
        reg = yaml.safe_load(open(os.path.join(HOME, "local", "projects.yaml")))["projects"]
    except (OSError, ValueError, KeyError, ImportError):
        return None
    scopes = set()
    for o in items:
        cwd = (o.get("cwd") or "").rstrip("/")
        if cwd == HOME.rstrip("/"):
            scopes.add("hub")
            continue
        best = None
        for p in reg:
            base = (p.get("path") or "").rstrip("/")
            if base and ((cwd + "/").startswith(base + "/") or (cwd + "/").startswith(base + ".wt/")) \
                    and (not best or len(base) > len(best["path"].rstrip("/"))):
                best = p
        scopes.add(best.get("scope") if best else None)
    return scopes.pop() if len(scopes) == 1 else None


def current_account():
    return (os.environ.get("CDX_SESSION_NAME") or os.environ.get("CROW_SESSION_ACCOUNT")
            or os.environ.get("CROW_ACCOUNT") or helper("crow-accounts", "default").strip())


def status(argv):
    current = current_account()
    st = account_status(current)
    if "--json" in argv:
        print(json.dumps(st, indent=1))
        return
    for a in st["accounts"]:
        mark = "*" if a["current"] else " "
        state = f"blocked: {a['blocked']}" if a["blocked"] else "ok"
        auto = " (auto fallback)" if a.get("fallback") == "auto" else ""
        print(f"{mark} {a['name']:<10} {a['policy']:<9} 5h {a['remaining_5h_pct']}%  week {a['remaining_week_pct']}%  {state}{auto}")
    if st["current_blocked"]:
        rec = st["auto_target"] or st["recommended"]
        print(f"\n{current} is blocked ({st['current_blocked']}). " +
              (f"Recommended target: {rec} ({'no OK needed' if rec == st['auto_target'] else accounts()[rec]['policy']}); relaunch with "
               f"`crow runs relaunch <id> {rec}` (see `crow runs sessions`)." if rec else "No allowed account is usable."))


# ---------- relaunch ----------

def resolve(ref):
    if not ref or not ID_RE.fullmatch(ref):
        die("a conversation id is required (see `crow runs sessions`); never relaunch without one")
    reg = json.loads(helper("crow-sessions", "scan", "--json"))
    hits = [s for s in reg["sessions"] if s["conversation_id"].startswith(ref)]
    if len(hits) > 1:
        die(f"{len(hits)} interrupted sessions start with '{ref}'; give more of the id")
    if hits:
        return hits[0]["conversation_id"], hits[0]["transcript"]
    paths = []
    for acct in sorted(os.listdir(PROFILES)) if os.path.isdir(PROFILES) else []:
        base = os.path.join(PROFILES, acct, "claude-home", ".claude", "projects")
        for slug in sorted(os.listdir(base)) if os.path.isdir(base) else []:
            if os.path.isfile(os.path.join(base, slug, ref + ".jsonl")):
                paths.append(os.path.join(base, slug, ref + ".jsonl"))
    if len(paths) != 1:
        die(f"conversation '{ref}' matches {len(paths)} transcripts; use a full id from `crow runs sessions`")
    return ref, paths[0]


def source_account(path):
    rel = os.path.relpath(os.path.realpath(path), os.path.realpath(PROFILES))
    if rel.startswith(".."):
        die(f"{path} is not inside a cdx profile")
    return rel.split(os.sep, 1)[0]


def workspace(path, cid):
    """The folder the conversation last worked in that still exists (cdx hands off from any folder it worked in)."""
    ids, cwds = set(), []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            try:
                ev = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if not isinstance(ev, dict) or ev.get("isSidechain"):
                continue
            if ev.get("sessionId"):
                ids.add(ev["sessionId"])
            if isinstance(ev.get("cwd"), str):
                cwd = os.path.realpath(ev["cwd"])
                if cwd in cwds:
                    cwds.remove(cwd)
                cwds.append(cwd)
    if ids != {cid}:
        die(f"transcript holds conversation ids {sorted(ids)}, expected only {cid}")
    ws = next((c for c in reversed(cwds) if os.path.isdir(c)), None)
    if not ws:
        die(f"none of the workspaces ({', '.join(cwds) or 'none'}) exists any more")
    return ws


def confirm(policy, yes, picked=False):
    if picked:
        return True
    if policy == "ask-first":
        if not sys.stdin.isatty():
            die("an ask-first account needs a typed yes on a terminal (--yes does not count)")
        return input('This is an ask-first account. Type "yes" to hand off: ').strip() == "yes"
    if yes:
        return True
    if not sys.stdin.isatty():
        die("no terminal to confirm on; pass --yes to confirm")
    return input("Hand off? [y/N] ").strip().lower() in ("y", "yes")


def relaunch(argv):
    flags = {a for a in argv if a.startswith("--")}
    args = [a for a in argv if not a.startswith("--")]
    known = {"--dry-run", "--yes", "--here", "--picked"}
    if flags - known:
        die(f"unknown option {sorted(flags - known)[0]}")
    if len(args) != 2:
        die("usage: crow-relaunch <conversation-id> <target> [--dry-run] [--yes] [--picked]  (an id is required)")
    ref, target = args
    accts = accounts()
    tpol = accts.get(target, {}).get("policy", "never")
    if tpol == "never":
        die(f"account '{target}' is not allowed (policy never)")
    cid, path = resolve(ref)
    source = source_account(path)
    if accts.get(source, {}).get("policy", "never") == "never":
        die(f"the transcript sits in '{source}', an account crow never uses")
    if source == target:
        die(f"the session already belongs to '{target}'; pick another account")
    ws = workspace(path, cid)

    cap = cdx_json("can-resume", target)
    if not cap.get("ok") or not cap.get("resumable"):
        die(f"cdx can-resume {target}: {cap.get('reason') or cap.get('message') or 'not resumable'}")
    why = blocked_reason(limits().get(target))
    if why:
        die(f"target '{target}' is blocked: {why}")

    cmd = ["cdx", "handoff", source, target, "--source-conversation", cid]
    print(f"session   {cid}\n  from    {source}  ({path})\n  to      {target}  (policy {tpol})\n"
          f"  in      {ws}\n  run     {' '.join(cmd)}")
    if "--dry-run" in flags:
        print("dry run: checks passed, nothing launched")
        return 0
    if not confirm(tpol, "--yes" in flags, "--picked" in flags):
        die("cancelled")

    record(cid, source, target, ws)
    if "--here" in flags:
        return run_handoff(cmd, ws, target, accts[target].get("memory") == "session")
    return open_window(cid, source, target, ws)


def run_handoff(cmd, ws, target, session_memory):
    if session_memory:
        helper("crow-memory", "link", target)
    try:
        return subprocess.run(cmd, cwd=ws, env={**os.environ, "CROW_ACCOUNT": target}).returncode
    finally:
        if session_memory:
            helper("crow-memory", "unlink", target)
            helper("crow-memory", "commit")


def open_window(cid, source, target, ws):
    """Detach like `crow term`: a new window from the terminal backend, real HOME, no inherited Claude/cdx variables."""
    backend = crow_term.choose()
    cmd = [os.path.join(BIN, "crow-relaunch"), "_run", cid, source, target, ws]
    try:
        out = crow_term.open_window(cmd, f"crow · relaunch {target}", ws, crow_term.clean_env(), backend=backend)
    except (OSError, subprocess.CalledProcessError) as e:
        die(f"could not open a {backend} window ({e}); rerun with --here")
    print(f"opened a {backend} window on {target}" if out == "opened" else f"run this in a new terminal: {out}")
    return 0


def run_in_window(argv):
    """Inside the new window: the handoff itself (already confirmed and recorded)."""
    if len(argv) != 4:
        die("_run is internal: <id> <source> <target> <workspace>")
    cid, source, target, ws = argv
    rc = run_handoff(["cdx", "handoff", source, target, "--source-conversation", cid], ws, target,
                     accounts().get(target, {}).get("memory") == "session")
    if rc:
        input(f"handoff exited {rc}; press Enter to close ")
    return rc


def record(cid, source, target, ws):
    helper("crow-sessions", "mark-relaunched", cid, source, target, ws)


# ---------- quota warning hook ----------

WARN_LEVELS = (95, 80)
WARNED = os.path.join(HOME, "local", "state", "quota-warned.json")


def fallback_line(st):
    alt = st["auto_target"] or st["recommended"]
    if not alt:
        return "No other allowed account is usable."
    a = next(x for x in st["accounts"] if x["name"] == alt)
    how = "no OK needed" if alt == st["auto_target"] else f"{a['policy']}: ask the owner first"
    return f"Fallback: {alt} (5h {a['used_5h_pct']}% used, {how})."


def hook(argv):
    """Print a warning for the model once per account, window and level. Never fails the prompt."""
    try:
        st = crow_lib.account_state(cached=True)
    except Exception:
        return 0
    cur = next((a for a in st["accounts"] if a["current"]), None)
    if not cur:
        return 0
    try:
        warned = json.load(open(WARNED))
    except (OSError, ValueError):
        warned = {}
    lines, seen = [], dict(warned)
    for win, used, reset in (("5h", cur["used_5h_pct"], cur["reset_5h_at"]),
                             ("week", cur["used_week_pct"], cur["reset_week_at"])):
        level = next((l for l in WARN_LEVELS if used is not None and used >= l), None)
        key = f"{cur['name']}|{win}|{reset}"
        if level is None or warned.get(key, 0) >= level:
            continue
        seen[key] = level
        lines.append(f"QUOTA {win}: account {cur['name']} has used {used}% of its {win} window (resets {reset}).")
        if level >= 95:
            lines.append("Tell the user now and suggest /wrap before the limit cuts the session off; "
                         "start no new background run on this account.")
        else:
            lines.append("Mention it to the user once; prefer small steps and avoid starting long runs.")
    if not lines:
        return 0
    lines.append(fallback_line(st))
    lines.append("After a cut-off: `crow rescue " + cur["name"] + " --dry-run` lists what to move.")
    print("\n".join(lines))
    try:
        os.makedirs(os.path.dirname(WARNED), exist_ok=True)
        with open(WARNED, "w") as fh:
            json.dump(dict(list(seen.items())[-50:]), fh)
    except OSError:
        pass
    return 0


# ---------- rescue ----------

WINDOW_H = 5


def stranded(account, now):
    """Sessions of `account` worth moving: cut off by a limit in the last window and not relaunched,
    plus interactive sessions still open on it (they cannot go on either)."""
    since = now - timedelta(hours=WINDOW_H)
    out = []
    for s in json.loads(helper("crow-sessions", "scan", "--json"))["sessions"]:
        if s["account"] != account or s.get("relaunched"):
            continue
        try:
            last = datetime.fromisoformat(s["last_event"].replace("Z", "+00:00"))
        except (KeyError, ValueError):
            continue
        if last >= since:
            out.append({"id": s["conversation_id"], "cwd": s["cwd"], "why": "cut off " + (s.get("message") or "")[:60],
                        "prompt": (s.get("last_prompt") or s.get("first_prompt") or "")[:70]})
    ids = {o["id"] for o in out}
    try:
        live = json.loads(helper("crow-runs", "json")).get("agents") or []
    except (SystemExit, ValueError):
        live = []
    me = os.environ.get("CLAUDE_SESSION_ID")
    for a in live:
        if a.get("kind") == "session" and a.get("account") == account and a.get("session_id") \
                and a["session_id"] not in ids and a["session_id"] != me:
            out.append({"id": a["session_id"], "cwd": a.get("cwd"), "why": f"open ({a.get('state')})",
                        "prompt": (a.get("title") or a.get("last_prompt") or "")[:70], "pid": a.get("pid")})
    return out


def rescue(argv):
    flags = [a for a in argv if a.startswith("--")]
    args = [a for a in argv if not a.startswith("--")]
    to = None
    if "--to" in argv:
        i = argv.index("--to")
        to = argv[i + 1] if i + 1 < len(argv) else die("--to needs an account")
        args.remove(to)
    if set(flags) - {"--to", "--dry-run"} or len(args) != 1:
        die("usage: crow-relaunch rescue <account> [--to <target>] [--dry-run]")
    source = args[0]
    accts = accounts()
    items = stranded(source, datetime.now().astimezone())
    scope = scope_of(items)
    st = account_status(source, scope) if scope else account_status(source)  # ranks in accounts.yaml route the pick by the sessions' scope
    target = to or st["auto_target"] or st["recommended"]
    if not target:
        die("no allowed account is usable")
    tpol = accts.get(target, {}).get("policy", "never")
    if tpol == "never" or target == source:
        die(f"'{target}' cannot take the sessions")
    tstate = next((a for a in st["accounts"] if a["name"] == target), {})
    if tstate.get("blocked"):
        die(f"target '{target}' is blocked: {tstate['blocked']}")
    if not items:
        print(f"nothing to rescue on {source} in the last {WINDOW_H}h")
        return 0
    auto = target == st["auto_target"] and tpol == "ask-first"
    print(f"{len(items)} session(s) on {source} -> {target} ({tpol}{', auto fallback' if auto else ''}):")
    for o in items:
        print(f"  {o['id'][:8]}  {o['why']:<28} {o['cwd']}\n            {o['prompt']}")
    if any(o.get("pid") for o in items):
        print("Open sessions keep running on the old account: close their windows after the new ones open.")
    if "--dry-run" in flags:
        print("dry run: nothing launched")
        return 0
    if not confirm("use" if auto else tpol, False):
        die("cancelled")
    failed = 0
    for o in items:
        try:
            cid, path = resolve(o["id"])
            ws = workspace(path, cid)
            record(cid, source, target, ws)
            open_window(cid, source, target, ws)
        except SystemExit as e:
            failed += 1
            print(f"  {o['id'][:8]} skipped: {e}", file=sys.stderr)
    return 1 if failed else 0


def main(argv):
    if argv[:1] == ["status"]:
        status(argv[1:])
    elif argv[:1] == ["hook"]:
        sys.exit(hook(argv[1:]))
    elif argv[:1] == ["rescue"]:
        sys.exit(rescue(argv[1:]))
    elif argv[:1] == ["_run"]:
        sys.exit(run_in_window(argv[1:]))
    elif not argv or argv[0] in ("-h", "--help", "help"):
        sys.exit(__doc__)
    else:
        sys.exit(relaunch(argv))


if __name__ == "__main__":
    main(sys.argv[1:])

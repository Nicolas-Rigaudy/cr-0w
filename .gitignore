# `local/` is its own private repo (private config and state), never part of this one.
local/
# Test homes for the crow.yaml loader carry a fake local/crow.yaml.
!tests/fixtures/modules/*/*/local/
.claude/settings.local.json
*.bak
tools/crow-watch/crow-watch
tools/crow-deck/crow-deck
tools/crow-core/crow-core
__pycache__/
.pytest_cache/
# Generated by crow-modules link: hub skills of on bricks and local/hub-skills.
.claude/skills/
logics/context-pack.json
logics/.cache/

# Third-party skills cloned by bin/crow-skills-ext (manifest: skills/ext.list)
vendor/
tools/nest/node_modules/
tools/nest/dist/
tools/nest/*.tsbuildinfo
